<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    SAHOOL Platform - OWASP Dependency-Check Suppressions
    Add false-positive CVE suppressions here.

    Format:
    <suppress>
        <notes>Reason for suppression</notes>
        <packageUrl regex="true">^pkg:pypi/package-name@.*$</packageUrl>
        <cve>CVE-YYYY-XXXXX</cve>
    </suppress>
    -->

    <!--
    ecdsa CVE-2024-23342 (Minerva attack via timing side-channel in ECDSA signing)
    The 'ecdsa' package (all versions including latest 0.19.1) is affected.
    No upstream fix is available; the project is effectively unmaintained.
    Impact: Transitive dependency pulled in by python-jose[cryptography].
    Mitigation: python-jose is used only for JWT token verification (not ECDSA signing);
    ECDSA signing is not performed in this service. The attack requires repeated
    signing operations with the same key, which is not part of our usage pattern.
    Review date: 2026-03-09
    -->
    <suppress>
        <notes>CVE-2024-23342: Minerva timing attack in ecdsa signing. No fix available
        in ecdsa (abandoned). Our usage is JWT verification only (not signing), so this
        vulnerability path is not reachable.</notes>
        <packageUrl regex="true">^pkg:pypi/ecdsa@.*$</packageUrl>
        <cve>CVE-2024-23342</cve>
    </suppress>

    <!--
    False positives: npm packages matched to unrelated native library CVEs.
    OWASP Dependency-Check sometimes matches JavaScript packages to C/C++ libraries
    with similar names. These are well-known false positives.
    Review date: 2026-03-14
    -->

    <!-- npm 'debug' package matched to GNU Debugger (gdb) CVEs -->
    <suppress>
        <notes>False positive: npm 'debug' package is not GNU Debugger (gdb).</notes>
        <packageUrl regex="true">^pkg:npm/debug@.*$</packageUrl>
        <cpe regex="true">^cpe:/a:gnu:gdb:.*$</cpe>
    </suppress>

    <!-- npm 'engine.io' matched to unrelated CVEs -->
    <suppress>
        <notes>False positive: npm 'engine.io' is a WebSocket library, not a native engine.</notes>
        <packageUrl regex="true">^pkg:npm/engine\.io@.*$</packageUrl>
        <cpe regex="true">^cpe:/a:engine\.io:engine\.io:.*$</cpe>
    </suppress>

    <!-- npm 'ws' package matched to unrelated WebSocket library CVEs already fixed -->
    <suppress>
        <notes>False positive: npm 'ws' DoS vulnerability only affects versions below 8.17.1.
        Our package.json enforces ws>=8.17.1 via overrides.</notes>
        <packageUrl regex="true">^pkg:npm/ws@[8-9]\..*$</packageUrl>
        <vulnerabilityName regex="true">^CVE-2024-3772[0-9]$</vulnerabilityName>
    </suppress>

    <!-- npm 'semver' matched to unrelated CVEs in older versions -->
    <suppress>
        <notes>False positive: npm 'semver' ReDoS only affects versions below 7.5.2.
        Our lockfile uses semver>=7.5.2.</notes>
        <packageUrl regex="true">^pkg:npm/semver@[7-9]\..*$</packageUrl>
        <cve>CVE-2022-25883</cve>
    </suppress>

    <!-- npm 'tough-cookie' matched to older CVEs -->
    <suppress>
        <notes>False positive: npm 'tough-cookie' prototype pollution only affects &lt;4.1.3.
        Our lockfile uses tough-cookie>=4.1.3.</notes>
        <packageUrl regex="true">^pkg:npm/tough-cookie@[4-9]\..*$</packageUrl>
        <cve>CVE-2023-26136</cve>
    </suppress>

    <!-- npm 'ip' package matched to SSRF CVE in older versions -->
    <suppress>
        <notes>False positive: npm 'ip' SSRF vulnerability only affects versions below 2.0.1.
        Our lockfile uses ip>=2.0.1.</notes>
        <packageUrl regex="true">^pkg:npm/ip@[2-9]\..*$</packageUrl>
        <cve>CVE-2024-29415</cve>
    </suppress>

    <!--
    Helm chart / Kubernetes manifest false positives.
    OWASP may scan YAML files in helm/ and gitops/ directories and match
    container image tags to CVEs in the underlying base images.
    These are deployment-time dependencies, not code dependencies.
    Review date: 2026-03-14
    -->
    <suppress>
        <notes>Helm charts and K8s manifests: container image CVEs are managed
        by infrastructure team via Trivy container scanning, not OWASP dep check.</notes>
        <filePath regex="true">^.*(helm|gitops|infrastructure)/.*\.(yaml|yml)$</filePath>
        <cpe regex="true">^cpe:/.*$</cpe>
    </suppress>

</suppressions>
