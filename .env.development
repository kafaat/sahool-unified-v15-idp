# ─────────────────────────────────────────────────────────────────────────────
# Core Application Settings
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=sahool_dev_password_2026
POSTGRES_DB=sahool

# Database URL for services (via PgBouncer - NO SSL for development)
# IMPORTANT: sslmode=disable because PgBouncer has TLS disabled in dev
DATABASE_URL=postgresql://sahool:sahool_dev_password_2026@pgbouncer:6432/sahool?sslmode=disable

# Direct PostgreSQL connection (for migrations only)
DATABASE_URL_DIRECT=postgresql://sahool:sahool_dev_password_2026@postgres:5432/sahool

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sahool_redis_dev_password_2026
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=512mb

# Redis URL (non-TLS for development)
REDIS_URL=redis://:sahool_redis_dev_password_2026@redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NATS Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
NATS_USER=sahool_app
NATS_PASSWORD=sahool_nats_dev_password_2026_min32
NATS_ADMIN_USER=nats_admin
NATS_ADMIN_PASSWORD=sahool_nats_admin_dev_password_2026
