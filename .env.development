NATS_CLUSTER_PASSWORD=sahool_nats_cluster_dev_password26
NATS_SYSTEM_USER=nats_system
NATS_SYSTEM_PASSWORD=sahool_nats_system_dev_password_26

# NATS JetStream Encryption Key (AES-256, 32 bytes)
NATS_JETSTREAM_KEY=sahool_jetstream_dev_key_32_bytes_min_dev_2026_xyz

# NATS URL (non-TLS for development)
NATS_URL=nats://sahool_app:sahool_nats_dev_password_2026_min32@nats:4222

# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=sahool_jwt_dev_secret_key_at_least_32_characters_long_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET=${JWT_SECRET_KEY}
