# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL v16.0.0 Development Environment
# Auto-generated for local development - DO NOT use in production
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Core Application Settings
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=sahool_dev_password_2026
POSTGRES_DB=sahool

# Database URL for services (via PgBouncer - NO SSL for development)
# IMPORTANT: sslmode=disable because PgBouncer has TLS disabled in dev
DATABASE_URL=postgresql://sahool:sahool_dev_password_2026@pgbouncer:6432/sahool?sslmode=disable

# Direct PostgreSQL connection (for migrations only)
DATABASE_URL_DIRECT=postgresql://sahool:sahool_dev_password_2026@postgres:5432/sahool

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sahool_redis_dev_password_2026
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=512mb

# Redis URL (non-TLS for development)
REDIS_URL=redis://:sahool_redis_dev_password_2026@redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NATS Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
NATS_USER=sahool_app
NATS_PASSWORD=sahool_nats_dev_password_2026_min32
NATS_ADMIN_USER=nats_admin
NATS_ADMIN_PASSWORD=sahool_nats_admin_dev_password_2026
NATS_MONITOR_USER=nats_monitor
NATS_MONITOR_PASSWORD=sahool_nats_monitor_dev_password26
NATS_CLUSTER_USER=nats_cluster
NATS_CLUSTER_PASSWORD=sahool_nats_cluster_dev_password26
NATS_SYSTEM_USER=nats_system
NATS_SYSTEM_PASSWORD=sahool_nats_system_dev_password_26

# NATS URL (non-TLS for development)
NATS_URL=nats://sahool_app:sahool_nats_dev_password_2026_min32@nats:4222

# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=sahool_jwt_dev_secret_key_at_least_32_characters_long_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET=${JWT_SECRET_KEY}
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# Kong API Gateway JWT Secrets
# ─────────────────────────────────────────────────────────────────────────────
STARTER_JWT_SECRET=sahool_starter_jwt_secret_min_32_chars_dev
PROFESSIONAL_JWT_SECRET=sahool_professional_jwt_secret_32_chars_dev
ENTERPRISE_JWT_SECRET=sahool_enterprise_jwt_secret_32_chars_dev
RESEARCH_JWT_SECRET=sahool_research_jwt_secret_min_32_chars_dev
ADMIN_JWT_SECRET=sahool_admin_jwt_secret_min_32_chars_dev_x
SERVICE_JWT_SECRET=sahool_service_jwt_secret_min_32_chars_dev
TRIAL_JWT_SECRET=sahool_trial_jwt_secret_min_32_chars_dev_x

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Etcd Configuration (REQUIRED for Milvus)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=sahool_etcd_dev_password_2026
ETCDCTL_API=3
ETCDCTL_ENDPOINTS=etcd:2379

# ─────────────────────────────────────────────────────────────────────────────
# MinIO Configuration (REQUIRED for Milvus)
# ─────────────────────────────────────────────────────────────────────────────
# MinIO requires minimum 16 characters for credentials
MINIO_ROOT_USER=sahool_minio_admin
MINIO_ROOT_PASSWORD=sahool_minio_dev_password_2026_secure

# ─────────────────────────────────────────────────────────────────────────────
# MQTT Configuration (REQUIRED for IoT)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USER=sahool_iot
MQTT_PASSWORD=sahool_mqtt_dev_password_2026

# ─────────────────────────────────────────────────────────────────────────────
# HashiCorp Vault
# ─────────────────────────────────────────────────────────────────────────────
VAULT_DEV_TOKEN=dev-root-token

# ─────────────────────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# Weather API (Optional - mock enabled by default)
# ─────────────────────────────────────────────────────────────────────────────
USE_MULTI_PROVIDER=false
USE_MOCK_WEATHER=true
WEATHER_CACHE_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Optional Service Credentials (leave empty for development)
# ─────────────────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
