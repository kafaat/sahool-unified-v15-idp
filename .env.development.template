# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL v16.0.0 - Development Environment Template (NO TLS)
# قالب بيئة التطوير المبسط - بدون TLS/SSL
# ═══════════════════════════════════════════════════════════════════════════════
# Last Updated: 2026-02-02
# Supports: 62+ microservices including new Vision, Terrain, Edge, and AI services
#
# USAGE: Copy this file to .env.development for local development
#        cp .env.development.template .env.development
#
# WARNING: This file is for DEVELOPMENT ONLY - DO NOT use in production!
#
# SECURITY: Replace all 'change_this_*' placeholders before starting.
#           Generate secure values with: openssl rand -base64 32
#
# IMPORTANT: Replace ALL placeholder values before use!
#            Generate secure passwords with: openssl rand -base64 24
# ═══════════════════════════════════════════════════════════════════════════════

# Core Settings
ENVIRONMENT=development
DEPLOYMENT_ENV=development
LOG_LEVEL=DEBUG
NODE_ENV=development
SERVICE_NAMESPACE=sahool
SKIP_DB_INIT=false
SKIP_E2E_TESTS=false
EVALUATION_MODE=false
BATCH_COUNT=100
INTERVAL_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL + PgBouncer) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=change_this_postgres_dev_password
POSTGRES_DB=sahool

# Development URLs (NO TLS)
# NOTE: Update password in URLs after setting POSTGRES_PASSWORD
DATABASE_URL=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool
DATABASE_URL_DIRECT=postgresql://sahool:change_this_postgres_dev_password@postgres:5432/sahool
DATABASE_URL_POOLED=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool

# ─────────────────────────────────────────────────────────────────────────────
# Redis - NO TLS
# PRODUCTION: MUST replace with a strong random password (openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sahool_redis_d3v_2026!secure
REDIS_URL=redis://:sahool_redis_d3v_2026!secure@redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NATS Message Queue - NO TLS
# PRODUCTION: MUST replace ALL passwords with strong random values (openssl rand -base64 32)
# IMPORTANT: If you change passwords here, you MUST also regenerate the bcrypt hashes
#            in config/nats/nats.conf to match. Use:
#            python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=11)).decode())"
# ─────────────────────────────────────────────────────────────────────────────
NATS_USER=sahool_app
NATS_PASSWORD=sahool_nats_d3v_2026!secure
NATS_ADMIN_USER=nats_admin
NATS_ADMIN_PASSWORD=sahool_nats_adm1n_2026!secure
NATS_MONITOR_USER=nats_monitor
NATS_MONITOR_PASSWORD=sahool_nats_m0n_2026!secure
NATS_CLUSTER_USER=nats_cluster
NATS_CLUSTER_PASSWORD=sahool_nats_clust3r_2026!secure
NATS_SYSTEM_USER=nats_system
NATS_SYSTEM_PASSWORD=sahool_nats_syst3m_2026!secure
NATS_JETSTREAM_KEY=change_this_jetstream_dev_key_32chars

# Development URL (NO TLS)
NATS_URL=nats://sahool_app:sahool_nats_d3v_2026!secure@nats:4222

# ─────────────────────────────────────────────────────────────────────────────
# etcd (for Milvus metadata)
# PRODUCTION: MUST replace with a strong random password (openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=sahool_etcd_d3v_2026!secure

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (Object Storage) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=sahool_minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_dev_password
MINIO_ACCESS_KEY=sahool_minio_admin
MINIO_SECRET_KEY=change_this_minio_dev_password
# Dedicated Milvus MinIO credentials (falls back to root if not set)
MILVUS_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MILVUS_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BROWSER=on
MINIO_PROMETHEUS_AUTH_TYPE=public

# ─────────────────────────────────────────────────────────────────────────────
# MQTT (IoT)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_USER=sahool_iot
MQTT_PASSWORD=change_this_mqtt_dev_password

# ─────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_jwt_secret_min_32_characters
JWT_SECRET=change_this_jwt_secret_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PEPPER=<your_password_pepper_here>
HMAC_SECRET=<your_hmac_secret_min_32_chars_here>
INTER_SERVICE_API_KEY=<your_inter_service_api_key_here>

# ─────────────────────────────────────────────────────────────────────────────
# Encryption
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<your_encryption_key_min_32_chars_here>
PREVIOUS_ENCRYPTION_KEY=
DETERMINISTIC_ENCRYPTION_KEY=<your_det_encryption_key_32_here>

# ─────────────────────────────────────────────────────────────────────────────
# Kong API Gateway
# ─────────────────────────────────────────────────────────────────────────────
KONG_DATABASE=postgres
KONG_PG_HOST=postgres
KONG_PG_USER=sahool
KONG_PG_PASSWORD=change_this_postgres_dev_password
KONG_PG_DATABASE=kong

# ─────────────────────────────────────────────────────────────────────────────
# InfluxDB (Metrics)
# ─────────────────────────────────────────────────────────────────────────────
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_this_influx_admin_password
INFLUXDB_USER=sahool
INFLUXDB_USER_PASSWORD=change_this_influx_user_password
INFLUXDB_DB=sahool_metrics
INFLUXDB_ADMIN_TOKEN=change_this_influx_admin_token

