# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL v16.0.0 - Development Environment Template (NO TLS)
# قالب بيئة التطوير المبسط - بدون TLS/SSL
# ═══════════════════════════════════════════════════════════════════════════════
# Last Updated: 2026-02-02
# Supports: 62+ microservices including new Vision, Terrain, Edge, and AI services
#
# USAGE: Copy this file to .env for local development
#        cp .env.development.template .env
#
# WARNING: This file is for DEVELOPMENT ONLY - DO NOT use in production!
#
# IMPORTANT: Replace ALL placeholder values before use!
#            Generate secure passwords with: openssl rand -base64 24
# ═══════════════════════════════════════════════════════════════════════════════

# Core Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL + PgBouncer) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=change_this_postgres_dev_password
POSTGRES_DB=sahool

# Development URLs (NO TLS)
# NOTE: Update password in URLs after setting POSTGRES_PASSWORD
DATABASE_URL=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool
DATABASE_URL_DIRECT=postgresql://sahool:change_this_postgres_dev_password@postgres:5432/sahool
DATABASE_URL_POOLED=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool

# ─────────────────────────────────────────────────────────────────────────────
# Redis - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_redis_dev_password
REDIS_URL=redis://:change_this_redis_dev_password@redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NATS Message Queue - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
NATS_USER=sahool_app
NATS_PASSWORD=change_this_nats_dev_password
NATS_ADMIN_USER=nats_admin
NATS_ADMIN_PASSWORD=change_this_nats_admin_dev_password
NATS_MONITOR_USER=nats_monitor
NATS_MONITOR_PASSWORD=change_this_nats_monitor_dev_password
NATS_CLUSTER_USER=nats_cluster
NATS_CLUSTER_PASSWORD=change_this_nats_cluster_dev_password
NATS_SYSTEM_USER=nats_system
NATS_SYSTEM_PASSWORD=change_this_nats_system_dev_password
NATS_JETSTREAM_KEY=change_this_jetstream_dev_key_32chars

# Development URL (NO TLS)
NATS_URL=nats://sahool_app:change_this_nats_dev_password@nats:4222

# ─────────────────────────────────────────────────────────────────────────────
# etcd (for Milvus metadata)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=change_this_etcd_dev_password

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (Object Storage) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=sahool_minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_dev_password
MINIO_ACCESS_KEY=sahool_minio_admin
MINIO_SECRET_KEY=change_this_minio_dev_password
MINIO_BROWSER=on
MINIO_PROMETHEUS_AUTH_TYPE=public

# ─────────────────────────────────────────────────────────────────────────────
# MQTT (IoT)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_USER=sahool_iot
MQTT_PASSWORD=change_this_mqtt_dev_password

# ─────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_jwt_secret_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Kong API Gateway
# ─────────────────────────────────────────────────────────────────────────────
KONG_DATABASE=postgres
KONG_PG_HOST=postgres
KONG_PG_USER=sahool
KONG_PG_PASSWORD=change_this_postgres_dev_password
KONG_PG_DATABASE=kong

# ─────────────────────────────────────────────────────────────────────────────
# InfluxDB (Metrics)
# ─────────────────────────────────────────────────────────────────────────────
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_this_influx_admin_password
INFLUXDB_USER=sahool
INFLUXDB_USER_PASSWORD=change_this_influx_user_password
INFLUXDB_DB=sahool_metrics
INFLUXDB_ADMIN_TOKEN=change_this_influx_admin_token

# ─────────────────────────────────────────────────────────────────────────────
# Service URLs (Development - No TLS)
# NOTE: Use new consolidated service names
# ─────────────────────────────────────────────────────────────────────────────
# Core Services
FIELD_MANAGEMENT_SERVICE_URL=http://field-management-service:3000
WEATHER_SERVICE_URL=http://weather-service:8092
VEGETATION_ANALYSIS_SERVICE_URL=http://vegetation-analysis-service:8090
CROP_INTELLIGENCE_SERVICE_URL=http://crop-intelligence-service:8095
ADVISORY_SERVICE_URL=http://advisory-service:8093

# Vision Services
YOLO26_VISION_SERVICE_URL=http://yolo26-vision-service:8150
GROUND_VISION_SERVICE_URL=http://ground-vision-service:8182

# Terrain Services
TERRAIN_CORE_SERVICE_URL=http://terrain-core-service:8185
HYDROLOGY_SERVICE_URL=http://hydrology-service:8165
LEVELING_OPTIMIZER_SERVICE_URL=http://leveling-optimizer-service:8170

# Edge Services
EDGE_ORCHESTRATOR_SERVICE_URL=http://edge-orchestrator-service:8180

# AI Agent Services
AI_AGENTS_SERVICE_URL=http://ai-agents-service:8130
AI_ADVISOR_URL=http://ai-advisor:8112
AGENT_REGISTRY_URL=http://agent-registry:8160

# Business Services
SKILLS_SERVICE_URL=http://skills-service:8121
CRM_SERVICE_URL=http://crm-service:8131
KNOWLEDGE_GRAPH_URL=http://knowledge-graph:8140
GLOBALGAP_COMPLIANCE_URL=http://globalgap-compliance:8128
LOGISTICS_SERVICE_URL=http://logistics-service:8167

# ─────────────────────────────────────────────────────────────────────────────
# AI/ML Configuration (Optional - leave empty if not using)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=codellama:7b

# ─────────────────────────────────────────────────────────────────────────────
# Vision Services Configuration
# ─────────────────────────────────────────────────────────────────────────────
YOLO26_MODEL_PATH=/models/yolo26_agri.pt
SAM_CHECKPOINT_PATH=/models/sam_vit_h.pth
YOLO_MODEL_PATH=/models/yolo_agri_ops.pt
MLLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────────
# AI Agent Configuration
# ─────────────────────────────────────────────────────────────────────────────
AI_AGENT_MAX_STEPS=10
AI_AGENT_TIMEOUT_SECONDS=300
AI_AGENT_RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────────
# Weather Configuration (Mock enabled for development)
# ─────────────────────────────────────────────────────────────────────────────
USE_MOCK_WEATHER=true
USE_MULTI_PROVIDER=false
WEATHER_CACHE_ENABLED=true
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Satellite Imagery (Optional - leave empty if not using)
# ─────────────────────────────────────────────────────────────────────────────
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# WeChat Integration (Optional)
# ─────────────────────────────────────────────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateways (Optional - sandbox mode)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
THARWATT_BASE_URL=https://developers-test.tharwatt.com:5253
THARWATT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CORS (Development - Allow All Localhost)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_dev_password

# ═══════════════════════════════════════════════════════════════════════════════
# END OF DEVELOPMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
