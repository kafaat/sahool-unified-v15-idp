# ─────────────────────────────────────────────────────────────────────────────
# System / Runtime Variables
# Auto-set by OS, container, or CI. Do NOT set manually in local dev.
# Listed here to document usage and satisfy drift detection.
# ─────────────────────────────────────────────────────────────────────────────
HOSTNAME=
POD_NAME=
TERM_PROGRAM=
NO_COLOR=
ENV=development
ANALYZE=false
DOTENV_CONFIG_DEBUG=false
NEXT_RUNTIME=

# ─────────────────────────────────────────────────────────────────────────────
# CI/CD Variables (Auto-set by GitHub Actions)
# Provided by CI runner at runtime. Do NOT set manually.
# ─────────────────────────────────────────────────────────────────────────────
CI=false
GITHUB_ACTIONS=
GITHUB_JOB=
GITHUB_OUTPUT=
GITHUB_REF=
GITHUB_REPOSITORY=
GITHUB_RUN_ID=
GITHUB_SHA=
GITHUB_STEP_SUMMARY=
GITHUB_WORKFLOW=

# ─────────────────────────────────────────────────────────────────────────────
# Prisma Engine Internals (Auto-managed by Prisma ORM)
# Set internally by Prisma. Do NOT set manually.
# ─────────────────────────────────────────────────────────────────────────────
PRISMA_CLIENT_DATA_PROXY_CLIENT_VERSION=
PRISMA_CLIENT_ENGINE_TYPE=
PRISMA_CLIENT_GET_TIME=
PRISMA_QUERY_ENGINE_BINARY=
PRISMA_QUERY_ENGINE_LIBRARY=

