RATE_LIMIT_FREE_RPH=500
RATE_LIMIT_FREE_BURST=10

# Tier: Standard
RATE_LIMIT_STANDARD_RPM=60
RATE_LIMIT_STANDARD_RPH=2000
RATE_LIMIT_STANDARD_BURST=20

# Tier: Premium
