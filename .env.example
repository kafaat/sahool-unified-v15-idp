# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL v16.0.0 - Development Environment Template (NO TLS)
# قالب بيئة التطوير المبسط - بدون TLS/SSL
# ═══════════════════════════════════════════════════════════════════════════════
# Last Updated: 2026-02-27
# Supports: 71+ microservices including Vision, Terrain, Edge, AI, and IoT services
#
# USAGE: Copy this file to .env for local development
#        cp .env.example .env
#
# WARNING: This file is for DEVELOPMENT ONLY - DO NOT use in production!
#
# IMPORTANT: Replace ALL placeholder values before use!
#            Generate secure passwords with: openssl rand -base64 24
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Core / General Settings
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEPLOYMENT_ENV=development
NODE_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_REQUEST_BODY=false
DEBUG=false
RELOAD=true
DEVELOPMENT_MODE=true
DEMO_MODE=false
ENABLE_MOCK_DATA=false
SEED_DEMO_DATA=false
INCLUDE_STACK_TRACE=true
PORT=8000
HOST=0.0.0.0
SERVICE_NAME=sahool
SERVICE_VERSION=16.0.0
SERVICE_NAMESPACE=sahool
SERVICE_BASE_URL=http://localhost:8000
ADMIN_BASE_URL=http://localhost:3001
SERVICES_HOST=localhost
API_AVAILABLE=true
SKIP_DB_INIT=false
SKIP_E2E_TESTS=false
EVALUATION_MODE=false
BATCH_COUNT=100
INTERVAL_SECONDS=60
ASSIMILATION_ENABLED=false
PROCESS_MODELS_ENABLED=false
AUTH_DISABLED_FOR_DEV=false

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL + PgBouncer) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=change_this_postgres_dev_password
POSTGRES_DB=sahool
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# Connection URLs (NO TLS)
# Note: pgbouncer=true is a Prisma-only parameter. Python services (psycopg2/asyncpg) do NOT support it.
# Use DATABASE_URL for Python services, DATABASE_URL_POOLED for Prisma/Node.js services.
DATABASE_URL=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool?sslmode=disable
DATABASE_URL_DIRECT=postgresql://sahool:change_this_postgres_dev_password@postgres:5432/sahool?sslmode=disable
DATABASE_URL_POOLED=postgresql://sahool:change_this_postgres_dev_password@pgbouncer:6432/sahool?sslmode=disable&pgbouncer=true

# Database connection (service-level aliases)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sahool
DB_USER=sahool
DB_PASSWORD=change_this_postgres_dev_password
DB_ECHO=false
SQL_ECHO=false
CREATE_DB_SCHEMA=true

# Connection pool settings
DB_POOL_SIZE=10
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_IDLE_TIMEOUT=300
DB_MAX_INACTIVE_LIFETIME=600
DB_COMMAND_TIMEOUT=30
DB_MAX_QUERIES=50000
DB_MAX_RETRIES=3
DB_RETRY_DELAY_SECONDS=1
DB_RETRY_BACKOFF_FACTOR=2

# Prisma ORM settings
PRISMA_DISABLE_WARNINGS=true

# ─────────────────────────────────────────────────────────────────────────────
# Redis - NO TLS
# PRODUCTION: MUST replace with a strong random password (openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sahool_redis_d3v_2026!secure
REDIS_URL=redis://:sahool_redis_d3v_2026!secure@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Redis Sentinel HA (optional - leave empty for standalone)
REDIS_MASTER_NAME=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_HOST_1=
REDIS_SENTINEL_HOST_2=
REDIS_SENTINEL_HOST_3=
REDIS_SENTINEL_PORT=26379

# ─────────────────────────────────────────────────────────────────────────────
# Cache Configuration
# ─────────────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=sahool
CACHE_MAX_SIZE=1000
CACHE_MAX_ITEMS=10000

# ─────────────────────────────────────────────────────────────────────────────
# NATS Message Queue - NO TLS
# PRODUCTION: MUST replace ALL passwords with strong random values (openssl rand -base64 32)
# IMPORTANT: If you change passwords here, you MUST also regenerate the bcrypt hashes
#            in config/nats/nats.conf to match. Use:
#            python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=11)).decode())"
# ─────────────────────────────────────────────────────────────────────────────
NATS_USER=sahool_app
NATS_PASSWORD=sahool_nats_d3v_2026!secure
NATS_ADMIN_USER=nats_admin
NATS_ADMIN_PASSWORD=sahool_nats_adm1n_2026!secure
NATS_MONITOR_USER=nats_monitor
NATS_MONITOR_PASSWORD=sahool_nats_m0n_2026!secure
NATS_CLUSTER_USER=nats_cluster
NATS_CLUSTER_PASSWORD=sahool_nats_clust3r_2026!secure
NATS_SYSTEM_USER=nats_system
NATS_SYSTEM_PASSWORD=sahool_nats_syst3m_2026!secure
NATS_JETSTREAM_KEY=change_this_jetstream_dev_key_32chars
NATS_URL=nats://sahool_app:sahool_nats_d3v_2026!secure@nats:4222
NATS_TLS_ENABLED=false
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
JETSTREAM_DOMAIN=sahool

# Dead Letter Queue (DLQ)
DLQ_HOST=nats
DLQ_PORT=4222
DLQ_STREAM_NAME=sahool_dlq
DLQ_MAX_RETRIES=5
DLQ_MAX_MESSAGES=10000
DLQ_MAX_AGE_DAYS=30
DLQ_INITIAL_DELAY=1000
DLQ_MAX_DELAY=60000
DLQ_BACKOFF_MULTIPLIER=2
DLQ_ALERT_ENABLED=true
DLQ_ALERT_THRESHOLD=100

# ─────────────────────────────────────────────────────────────────────────────
# MQTT (IoT) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
MQTT_USER=sahool_iot
MQTT_PASSWORD=change_this_mqtt_dev_password
MQTT_BROKER=mosquitto
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_PORT=1883
MQTT_TOPIC=sahool/#
MQTT_USERNAME=sahool_iot
IOT_AUTO_REGISTER=true

# MQTT Per-Service Credentials (P0 Security Fix)
# Each IoT service should use its own MQTT credentials for least-privilege access
# يجب أن تستخدم كل خدمة IoT بيانات اعتماد MQTT خاصة بها لتقليل الصلاحيات
MQTT_IOT_GATEWAY_PASSWORD=change_me_iot_gateway
MQTT_SENSOR_HUB_PASSWORD=change_me_sensor_hub
MQTT_EDGE_PASSWORD=change_me_edge
MQTT_IRRIGATION_PASSWORD=change_me_irrigation

# ─────────────────────────────────────────────────────────────────────────────
# etcd (for Milvus metadata)
# PRODUCTION: MUST replace with a strong random password (openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=sahool_etcd_d3v_2026!secure

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (Object Storage) - NO TLS
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=sahool_minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_dev_password
MINIO_ACCESS_KEY=sahool_minio_admin
MINIO_SECRET_KEY=change_this_minio_dev_password
# Dedicated Milvus service account (least privilege - only milvus-bucket access)
# Falls back to root credentials if not set (not recommended for production)
MILVUS_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MILVUS_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BROWSER=on
MINIO_REGION=me-south-1
MINIO_PROMETHEUS_AUTH_TYPE=public
S3_BUCKET=sahool-uploads
CDN_BASE_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_jwt_secret_min_32_characters
# JWT_SECRET is a legacy alias for JWT_SECRET_KEY (some services still read it)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_EXPIRY_MINUTES=60
JWT_LEEWAY_SECONDS=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=sahool
JWT_AUDIENCE=sahool-api
AUTH_SECRET_KEY=change_this_auth_secret_min_32_characters
PASSWORD_PEPPER=<your_password_pepper_here>
HMAC_SECRET=<your_hmac_secret_min_32_chars_here>
TOKEN_REVOCATION_ENABLED=true
ENABLE_AUTH_BYPASS=false
INTER_SERVICE_API_KEY=<your_inter_service_api_key_here>
JWT_SECRET=change_this_jwt_secret_min_32_characters
# Set to true in development if no real OTP provider is configured
ALLOW_INSECURE_OTP=false

# ─────────────────────────────────────────────────────────────────────────────
# Encryption
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<your_encryption_key_min_32_chars_here>
PREVIOUS_ENCRYPTION_KEY=
DETERMINISTIC_ENCRYPTION_KEY=<your_det_encryption_key_32_here>

# ─────────────────────────────────────────────────────────────────────────────
# Kong API Gateway
# ─────────────────────────────────────────────────────────────────────────────
KONG_DATABASE=postgres
KONG_PG_HOST=postgres
KONG_PG_USER=sahool
KONG_PG_PASSWORD=change_this_postgres_dev_password
KONG_PG_DATABASE=kong
KONG_URL=http://kong:8001

# ─────────────────────────────────────────────────────────────────────────────
# InfluxDB (Metrics)
# ─────────────────────────────────────────────────────────────────────────────
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_this_influx_admin_password
INFLUXDB_USER=sahool
INFLUXDB_USER_PASSWORD=change_this_influx_user_password
INFLUXDB_DB=sahool_metrics
INFLUXDB_ADMIN_TOKEN=change_this_influx_admin_token

