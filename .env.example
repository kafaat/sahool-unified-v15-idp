# API Gateway / Frontend
API_BASE_URL=http://localhost:8000
API_ENDPOINT=http://localhost:8000/api/v1
API_GATEWAY_URL=http://kong:8000
API_KEY=
SAHOOL_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AI/ML Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-coder

# Claude
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible endpoint (for local/proxy LLMs)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# External LLM (generic)
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_TEMPERATURE=0.7

# Agricultural AI APIs (optional)
AGROGPT_API_KEY=
CROPWIZARD_API_KEY=
PLANTGPT_API_KEY=
SHENGNONG_API_KEY=

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=codellama:7b
OLLAMA_DEFAULT_MODEL=codellama:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
USE_OLLAMA=true

# vLLM Inference Server (GPU - DeepSeek Coder)
VLLM_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct
VLLM_PORT=8270
VLLM_HOST=0.0.0.0
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_COUNT=1
VLLM_MEMORY_LIMIT=32G
VLLM_BASE_URL=http://vllm:8270/v1
# API key used to authenticate requests to the vLLM inference server
# مفتاح واجهة برمجة التطبيقات لمصادقة الطلبات إلى خادم vLLM
VLLM_API_KEY=

# LLM Response Cache
# Maximum number of LLM responses to keep in the in-memory LRU cache (entries count).
# Set to 0 to disable caching. Typical values: 100–1000 depending on memory.
LLM_CACHE_MAX_SIZE=256

# HuggingFace
HF_TOKEN=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_CACHE_DIR=/tmp/huggingface
HUGGINGFACE_MODEL_DIR=/tmp/huggingface/models
HUGGINGFACE_MODEL_REVISION=main

# Arabic NLP (AraBERT)
ARABERT_MODEL=aubmindlab/bert-base-arabertv2
ARABERT_REVISION=main

# AgML (Agricultural ML datasets)
AGML_CACHE_DIR=/tmp/agml

# ML model storage
MODELS_DIR=/app/models
DEVICE=cpu

# ─────────────────────────────────────────────────────────────────────────────
# Vector Database / RAG
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=change_me_qdrant_api_key
QDRANT_COLLECTION=sahool_embeddings
VECTOR_STORE_PATH=/tmp/vector_store

# UltraRAG configuration
ULTRARAG_DENSE_WEIGHT=0.7
ULTRARAG_SPARSE_WEIGHT=0.3
ULTRARAG_KG_WEIGHT=0.2
ULTRARAG_KG_MAX_HOPS=2
ULTRARAG_ENABLE_AGRI=true
ULTRARAG_ENABLE_CODE=true
ULTRARAG_ENABLE_GEE=false

# ─────────────────────────────────────────────────────────────────────────────
# Vision Services Configuration
# ─────────────────────────────────────────────────────────────────────────────
YOLO26_MODEL_PATH=/models/yolo26_agri.pt
SAM_CHECKPOINT_PATH=/models/sam_vit_h.pth
YOLO_MODEL_PATH=/models/yolo_agri_ops.pt
MLLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────────
# AI Agent Configuration
# ─────────────────────────────────────────────────────────────────────────────
AI_AGENT_MAX_STEPS=10
AI_AGENT_TIMEOUT_SECONDS=300
AI_AGENT_RETRY_ATTEMPTS=3
AI_AUDIT_STORAGE_PATH=/tmp/ai_audit
FEEDBACK_STORAGE_PATH=/tmp/feedback

# AGL (Agricultural General Language)
AGL_ENABLED=false
AGL_LLM_PROXY_URL=
AGL_STORE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# MCP (Model Context Protocol) Server
# ─────────────────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8201
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8201
MCP_TRANSPORT=stdio
MCP_DEBUG=false
MCP_BILINGUAL=true
MCP_DEFAULT_LANGUAGE=ar
MCP_DEFAULT_MODEL=codellama:7b
MCP_DEFAULT_TIMEOUT=30
MCP_LONG_TIMEOUT=120
MCP_MAX_AGENTS=10
MCP_AGENT_TIMEOUT=300
MCP_AGENT_CLEANUP_INTERVAL=60
MCP_RATE_LIMIT_TIER=standard
MCP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Copilot API Configuration
# ─────────────────────────────────────────────────────────────────────────────
COPILOT_EMBEDDING_PROVIDER=sentence_transformers
COPILOT_EMBEDDING_MODEL=all-MiniLM-L6-v2
COPILOT_USE_QDRANT=false
COPILOT_ENABLE_EXTERNAL=false
COPILOT_DOMAIN_ALLOWLIST=sahool.app,localhost
COPILOT_TOOL_ALLOWLIST=*
COPILOT_MAX_PROMPT_CHARS=10000
COPILOT_MAX_ARGS_SIZE=5000
COPILOT_MAX_FILES_CHANGED=20
COPILOT_REQUEST_TIMEOUT_S=30

# SAHOOL Copilot Limits
SAHOOL_DOMAIN_ALLOWLIST=sahool.app,localhost
SAHOOL_TOOL_ALLOWLIST=*
SAHOOL_ENABLE_EXTERNAL=false
SAHOOL_MAX_PROMPT_CHARS=10000
SAHOOL_MAX_ARGS_SIZE=5000
SAHOOL_MAX_FILES_CHANGED=20
SAHOOL_MAX_OUTPUT_SIZE=50000
SAHOOL_REQUEST_TIMEOUT_S=30

