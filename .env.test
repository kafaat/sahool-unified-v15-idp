# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL v16.0.0 Test Environment Configuration
# بيئة الاختبار لمنصة سهول
# ═══════════════════════════════════════════════════════════════════════════════
# This file is used for automated testing (CI/CD, local tests)
# WARNING: These are TEST credentials - DO NOT use in production!
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Core Application Settings
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=test
NODE_ENV=test
LOG_LEVEL=WARNING
TZ=UTC

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (Empty for unit tests, testcontainers for integration)
# ─────────────────────────────────────────────────────────────────────────────
# Leave empty for unit tests - they should mock database calls
# Integration tests use testcontainers or a dedicated test database
DATABASE_URL=
POSTGRES_USER=test_sahool
POSTGRES_PASSWORD=test_password_not_for_production_123
POSTGRES_DB=sahool_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (Empty for unit tests)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_PASSWORD=test_redis_password_not_for_production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15

# ─────────────────────────────────────────────────────────────────────────────
# NATS Configuration (Empty for unit tests)
# ─────────────────────────────────────────────────────────────────────────────
NATS_URL=
NATS_USER=test_nats
NATS_PASSWORD=test_nats_password_not_for_production
NATS_ADMIN_USER=test_nats_admin
NATS_ADMIN_PASSWORD=test_nats_admin_password_not_for_production
NATS_MONITOR_USER=test_nats_monitor
NATS_MONITOR_PASSWORD=test_nats_monitor_password_not_for_production
NATS_CLUSTER_USER=test_nats_cluster
NATS_CLUSTER_PASSWORD=test_nats_cluster_password_not_for_production
NATS_SYSTEM_USER=test_nats_system
NATS_SYSTEM_PASSWORD=test_nats_system_password_not_for_production
NATS_JETSTREAM_KEY=test_jetstream_key_not_for_production_32ch

# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration (Test-only keys)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=test-secret-key-for-unit-tests-only-32chars-minimum-length-required
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# MQTT Configuration (Empty for unit tests)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=test_mqtt
MQTT_PASSWORD=test_mqtt_password_not_for_production

# ─────────────────────────────────────────────────────────────────────────────
# etcd Configuration (Empty for unit tests)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_HOST=localhost
ETCD_PORT=2379
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=test_etcd_password_not_for_production

# ─────────────────────────────────────────────────────────────────────────────
# MinIO Configuration (Empty for unit tests)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=test_minio_admin
MINIO_ROOT_PASSWORD=test_minio_password_16_chars
MILVUS_MINIO_ACCESS_KEY=test_minio_admin
MILVUS_MINIO_SECRET_KEY=test_minio_password_16_chars
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=sahool-test

# ─────────────────────────────────────────────────────────────────────────────
# External API Keys (Use mocks in tests - leave empty or use test keys)
# ─────────────────────────────────────────────────────────────────────────────
# Weather APIs (use mock weather in tests)
USE_MOCK_WEATHER=true
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=

# Satellite APIs (use mock data in tests)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# AI APIs (use mock or local Ollama in tests)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Payment APIs (use test/sandbox mode)
STRIPE_API_KEY=sk_test_mock_stripe_key_for_testing_only
STRIPE_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_for_testing
THARWATT_API_KEY=
THARWATT_BASE_URL=https://developers-test.tharwatt.com:5253

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags for Testing
# ─────────────────────────────────────────────────────────────────────────────
USE_MULTI_PROVIDER=false
WEATHER_CACHE_ENABLED=false
WEATHER_ALERTS_ENABLED=false
WEATHER_AG_INDICES_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Vision Services (disabled in unit tests)
# ─────────────────────────────────────────────────────────────────────────────
YOLO26_MODEL_PATH=
SAM_CHECKPOINT_PATH=
YOLO_MODEL_PATH=
MLLM_PROVIDER=mock

# ─────────────────────────────────────────────────────────────────────────────
# AI Agent Settings for Testing
# ─────────────────────────────────────────────────────────────────────────────
AI_AGENT_MAX_STEPS=3
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_RETRY_ATTEMPTS=1

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration (Allow all for tests)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────────
# Notification Services (disabled in tests)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SLACK_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Firebase (disabled in tests)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════════
# TEST-SPECIFIC NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# Unit Tests:
# - Most URL/connection variables should be empty
# - Tests should mock external dependencies
# - Use pytest markers: @pytest.mark.unit
#
# Integration Tests:
# - Use testcontainers for PostgreSQL, Redis, NATS
# - Set DATABASE_URL, REDIS_URL, NATS_URL dynamically in fixtures
# - Use pytest markers: @pytest.mark.integration
#
# E2E Tests:
# - Use docker-compose.test.yml for full environment
# - Set all required variables
# - Use pytest markers: @pytest.mark.e2e
#
# Coverage Requirements:
# - Minimum: 60% code coverage (enforced in CI)
# - Target: 80% for new code
#
# ═══════════════════════════════════════════════════════════════════════════════
