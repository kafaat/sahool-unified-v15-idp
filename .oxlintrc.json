{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-debugger": "error",
    "eqeqeq": "warn",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "settings": {},
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    "archive",
    "*.min.js",
    "*.d.ts"
  ]
}
