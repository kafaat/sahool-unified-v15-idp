# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL Test Runner Dockerfile
# Dockerfile لتشغيل اختبارات سهول
#
# This Dockerfile creates a container for running tests
# ═══════════════════════════════════════════════════════════════════════════════

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
COPY docker/apt-update.sh /usr/local/bin/
RUN apt-update.sh && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for running tests
RUN groupadd --system --gid 1000 sahool && \
    useradd --system --uid 1000 --gid sahool --shell /bin/bash --create-home sahool

# Copy requirements files
COPY requirements/test-requirements.txt ./requirements/

# Configure pip for network resilience
RUN mkdir -p /root/.pip && \
    printf '[global]\ntimeout = 300\nretries = 10\nindex-url = https://mirrors.aliyun.com/pypi/simple/\nextra-index-url = https://pypi.tuna.tsinghua.edu.cn/simple/\n                  https://pypi.org/simple/\n[install]\nprefer-binary = true\n' > /root/.pip/pip.conf

# Install Python dependencies
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -r requirements/test-requirements.txt || \
    pip install --no-cache-dir --timeout=600 --retries=5 \
    --index-url https://pypi.org/simple \
    -r requirements/test-requirements.txt || \
    pip install --no-cache-dir --timeout=600 --retries=5 \
    -i https://mirrors.cloud.tencent.com/pypi/simple \
    -r requirements/test-requirements.txt

# Copy test configuration
COPY pyproject.toml ./
COPY conftest.py ./

# Copy source code and tests
COPY tests ./tests
COPY apps ./apps
COPY packages ./packages
COPY shared ./shared

# Create directory for test results
RUN mkdir -p test-results

# Set ownership
RUN chown -R sahool:sahool /app

# Set environment
ENV PYTHONPATH=/app
ENV ENVIRONMENT=test

# Switch to non-root user
USER sahool

# Default command runs all tests
CMD ["pytest", "tests/", "-v", "--tb=short"]
