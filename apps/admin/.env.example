# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL Admin Portal Environment Configuration
# تكوين بيئة بوابة إدارة سهول
#
# Copy this file to .env.local for local development
# انسخ هذا الملف إلى .env.local للتطوير المحلي
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost:8081
NEXT_PUBLIC_AUTH_URL=http://localhost:8001

# ─────────────────────────────────────────────────────────────────────────────
# App Info
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SAHOOL Admin
NEXT_PUBLIC_APP_VERSION=16.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_MAPS=true
NEXT_PUBLIC_FEATURE_CHARTS=true

# ─────────────────────────────────────────────────────────────────────────────
# Security (Server-side only - NEVER expose to client)
# الأمان (من جانب الخادم فقط - لا تعرض للعميل أبداً)
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: JWT configuration must match root .env file
# This is used for verifying tokens from user-service
# Generate with: openssl rand -base64 32
JWT_SECRET=change_this_jwt_secret_key_at_least_32_characters_long
JWT_SECRET_KEY=change_this_jwt_secret_key_at_least_32_characters_long
JWT_ISSUER=sahool-platform
JWT_AUDIENCE=sahool-users
JWT_ALGORITHM=HS256

# CORS Configuration (for API endpoints)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://admin.sahool.app,https://sahool.app,http://localhost:3002

# Rate Limiting Configuration
ENABLE_RATE_LIMITING=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000  # 15 minutes in milliseconds

# Redis (for session storage and rate limiting)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Build Configuration
# ─────────────────────────────────────────────────────────────────────────────
# ANALYZE=true
