# SAHOOL Admin Dashboard - Environment Variables
# Copy this file to .env.local for local development

# API URL - Backend services gateway (build-time, baked into client JS)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Gateway URL - Server-side runtime override for Next.js rewrites
# In production (Docker/K8s), set this to the internal Kong gateway URL:
#   Docker Compose: http://kong-gateway:8000
#   Kubernetes:     http://kong.kong.svc.cluster.local:8000
# If unset, falls back to NEXT_PUBLIC_API_URL → http://localhost:8000
API_GATEWAY_URL=

# Sentry DSN - Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# App version (auto-set in CI)
NEXT_PUBLIC_APP_VERSION=16.0.0

# Bundle analyzer (set to "true" to enable)
ANALYZE=
