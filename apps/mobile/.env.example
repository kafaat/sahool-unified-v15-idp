# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL Mobile Application - Environment Configuration
# تكوين بيئة تطبيق سهول الميداني
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file serves as a template for environment configuration.
# Copy this file to create environment-specific files:
#   - .env.development  (local development)
#   - .env.staging      (staging environment)
#   - .env.production   (production environment)
#
# Or copy to .env for local overrides (not committed to git)
#
# Priority: dart-define > .env.{environment} > .env > .env.example > defaults
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────────
# Options: development, staging, production
ENV=development

# ─────────────────────────────────────────────────────────────────────────────────
# API CONFIGURATION
# تكوين API - Kong API Gateway
# ─────────────────────────────────────────────────────────────────────────────────
# Development (Android Emulator): http://10.0.2.2:8000/api/v1
# Development (iOS Simulator): http://localhost:8000/api/v1
# Development (Physical Device): http://<your-local-ip>:8000/api/v1
# Staging: https://api-staging.sahool.app/api/v1
# Production: https://api.sahool.app/api/v1
API_BASE_URL=http://10.0.2.2:8000/api/v1

# API Version
API_VERSION=v1

# ─────────────────────────────────────────────────────────────────────────────────
# HOST CONFIGURATION
# تكوين المضيفين
# ─────────────────────────────────────────────────────────────────────────────────
# Development host (Android Emulator: 10.0.2.2, iOS Simulator: localhost)
DEV_HOST=10.0.2.2

# Production and Staging hosts
PROD_HOST=api.sahool.app
STAGING_HOST=api-staging.sahool.app

# ─────────────────────────────────────────────────────────────────────────────────
# WEBSOCKET CONFIGURATION
# تكوين WebSocket
# ─────────────────────────────────────────────────────────────────────────────────
# Development: ws://10.0.2.2:8081
# Staging: wss://ws-staging.sahool.app
# Production: wss://ws.sahool.app
WS_GATEWAY_URL=ws://10.0.2.2:8081

# ─────────────────────────────────────────────────────────────────────────────────
# NATS MESSAGE QUEUE
# ─────────────────────────────────────────────────────────────────────────────────
# Event-driven architecture message queue
# Development: nats://10.0.2.2:4222
# Production: nats://nats.sahool.app:4222
NATS_URL=nats://10.0.2.2:4222

# ─────────────────────────────────────────────────────────────────────────────────
# WEATHER API CONFIGURATION
# تكوين API الطقس
# ─────────────────────────────────────────────────────────────────────────────────
# Primary weather provider (open-meteo, openweathermap, weatherapi, visualcrossing)
WEATHER_PROVIDER=open-meteo

# OpenWeatherMap API Key (optional - Open-Meteo is free and used by default)
# Get key from: https://openweathermap.org/api
WEATHER_API_KEY=

# WeatherAPI.com Key (optional)
# Get key from: https://www.weatherapi.com/
WEATHERAPI_KEY=

# Visual Crossing API Key (optional)
# Get key from: https://www.visualcrossing.com/weather-api
VISUALCROSSING_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# MAPS CONFIGURATION
# تكوين الخرائط
# ─────────────────────────────────────────────────────────────────────────────────
# Default map provider (osm, mapbox, google, esri)
MAP_PROVIDER=osm

# Mapbox Access Token (required for Mapbox styles)
# Get token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Mapbox Style URL
MAPBOX_STYLE_URL=mapbox://styles/mapbox/satellite-streets-v12

# Google Maps API Key (required for Google Maps)
# Get key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Custom map tile URL (for self-hosted tiles)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Enable offline map caching
ENABLE_OFFLINE_MAPS=true

# ─────────────────────────────────────────────────────────────────────────────────
# ERROR REPORTING & MONITORING
# تقارير الأخطاء والمراقبة
# ─────────────────────────────────────────────────────────────────────────────────
# Sentry DSN for crash reporting
# Get DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=

# Sentry Environment (auto-detected from ENV if not set)
SENTRY_ENVIRONMENT=

# Enable crash reporting (disabled in development by default)
ENABLE_CRASH_REPORTING=false

# Enable analytics tracking
ENABLE_ANALYTICS=false

# ─────────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# أعلام الميزات
# ─────────────────────────────────────────────────────────────────────────────────
# Offline-first functionality
ENABLE_OFFLINE_MODE=true

# Background sync with Workmanager
ENABLE_BACKGROUND_SYNC=true

# Camera for crop health diagnosis
ENABLE_CAMERA=true

# Push notifications (requires Firebase setup)
ENABLE_PUSH_NOTIFICATIONS=false

# Edge AI for on-device inference
ENABLE_EDGE_AI=false

# Voice commands (experimental)
ENABLE_VOICE=false

# Augmented Reality features (experimental)
ENABLE_AR=false

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY SETTINGS
# إعدادات الأمان
# ─────────────────────────────────────────────────────────────────────────────────
# Enable biometric authentication (Face ID, Touch ID, Fingerprint)
ENABLE_BIOMETRIC_AUTH=true

# Enable SSL certificate pinning (recommended for production)
ENABLE_CERTIFICATE_PINNING=false

# Enable device integrity checks (root/jailbreak detection)
ENABLE_DEVICE_INTEGRITY=false

# Enable database encryption with SQLCipher
ENABLE_DATABASE_ENCRYPTION=false

# Skip device security checks (DEVELOPMENT ONLY)
SKIP_DEVICE_CHECKS=true

# ─────────────────────────────────────────────────────────────────────────────────
# SYNC CONFIGURATION
# تكوين المزامنة
# ─────────────────────────────────────────────────────────────────────────────────
# Foreground sync interval (seconds)
SYNC_INTERVAL_SECONDS=30

# Background sync interval (minutes)
BG_SYNC_INTERVAL_MINUTES=15

# Maximum retry attempts for failed sync operations
MAX_RETRY_COUNT=5

# Outbox batch size for bulk sync
OUTBOX_BATCH_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────────
# CACHE CONFIGURATION
# تكوين التخزين المؤقت
# ─────────────────────────────────────────────────────────────────────────────────
# Cache expiry for API responses (hours)
CACHE_EXPIRY_HOURS=24

# Image cache expiry (days)
IMAGE_CACHE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────────
# TIMEOUT CONFIGURATION
# تكوين المهلات
# ─────────────────────────────────────────────────────────────────────────────────
# Connection timeout (seconds) - longer for poor connectivity areas
CONNECT_TIMEOUT_SECONDS=30

# Receive timeout (seconds)
RECEIVE_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────────────
# APP INFORMATION
# معلومات التطبيق
# ─────────────────────────────────────────────────────────────────────────────────
APP_NAME=SAHOOL Field
APP_VERSION=16.0.0
BUILD_NUMBER=1

# Default tenant ID for multi-tenancy
DEFAULT_TENANT_ID=sahool-demo

# ─────────────────────────────────────────────────────────────────────────────────
# AI SERVICE CONFIGURATION
# تكوين خدمة الذكاء الاصطناعي
# ─────────────────────────────────────────────────────────────────────────────────
# AI Service URL for crop diagnosis and recommendations
AI_SERVICE_URL=http://10.0.2.2:8095

# ─────────────────────────────────────────────────────────────────────────────────
# SERVICE PORTS (Development Only)
# منافذ الخدمات (للتطوير فقط)
# ─────────────────────────────────────────────────────────────────────────────────
# These are only used in development when connecting directly to services
GATEWAY_PORT=8000
FIELD_CORE_PORT=3000
MARKETPLACE_PORT=3010
CHAT_PORT=8099
SATELLITE_PORT=8090
INDICATORS_PORT=8091
WEATHER_PORT=8092
FERTILIZER_PORT=8093
IRRIGATION_PORT=8094
CROP_HEALTH_PORT=8095
VIRTUAL_SENSORS_PORT=8119
COMMUNITY_CHAT_PORT=8097
SPRAY_PORT=8098
EQUIPMENT_PORT=8101
INVENTORY_PORT=8116
NOTIFICATIONS_PORT=8110

# ─────────────────────────────────────────────────────────────────────────────────
# DEBUG SETTINGS (Development Only)
# إعدادات التصحيح (للتطوير فقط)
# ─────────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=true
LOG_LEVEL=debug
