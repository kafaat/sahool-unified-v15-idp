# SAHOOL Mobile Environment Configuration
# تكوين بيئة تطبيق ساهول
#
# This file is committed with safe defaults for CI/CD.
# For local development, override values as needed.
# هذا الملف يحتوي على قيم افتراضية آمنة للـ CI/CD
#
# Priority: dart-define > .env > defaults in EnvConfig

# Environment (development/staging/production)
ENV=development

# API Configuration (defaults are in EnvConfig)
# API_BASE_URL=http://10.0.2.2:8000/api/v1

# Feature Flags (all have safe defaults)
# ENABLE_OFFLINE_MODE=true
# ENABLE_BACKGROUND_SYNC=true
