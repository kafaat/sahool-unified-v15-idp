# SAHOOL Mobile Environment Configuration
# تكوين بيئة تطبيق سهول
#
# This file is committed with safe defaults for CI/CD.
# For local development, override values as needed.
# هذا الملف يحتوي على قيم افتراضية آمنة للـ CI/CD
#
# Priority: dart-define > .env > defaults in EnvConfig

# ─────────────────────────────────────────────────────────────────────────────
# Environment (development/staging/production)
# ─────────────────────────────────────────────────────────────────────────────
ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# API Configuration - Kong API Gateway
# تكوين API عبر بوابة Kong (Port 8000)
# ─────────────────────────────────────────────────────────────────────────────
# Kong Gateway Port: 8000 (default)
#
# Development (Android Emulator): http://10.0.2.2:8000
# Development (iOS Simulator): http://localhost:8000
# Development (Physical Device): http://<your-local-ip>:8000
# Staging: https://api-staging.sahool.io
# Production: https://api.sahool.io
API_BASE_URL=http://10.0.2.2:8000

# API Version
API_VERSION=v1

# ─────────────────────────────────────────────────────────────────────────────
# External API Keys (optional for development, required for production)
# مفاتيح API الخارجية
# ─────────────────────────────────────────────────────────────────────────────
# WEATHER_API_KEY=your_weather_api_key_here
# MAPS_API_KEY=your_maps_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags (all have safe defaults in EnvConfig)
# أعلام الميزات
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_OFFLINE_MODE=true
ENABLE_BACKGROUND_SYNC=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=false

# ─────────────────────────────────────────────────────────────────────────────
# Debug Settings (set to false in production)
# إعدادات التصحيح
# ─────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
# Skip device integrity checks in development only
SKIP_DEVICE_CHECKS=false
