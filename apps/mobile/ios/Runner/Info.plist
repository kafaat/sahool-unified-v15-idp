<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sahool Field App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sahool_field_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Global settings -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>

		<!-- Certificate Pinning for Production Domains -->
		<!-- NOTE: NSPinnedDomains disabled until real SPKI hashes are generated. -->
		<!-- Placeholder values (AAAA...) would block ALL connections to pinned domains. -->
		<!-- Certificate pinning is enforced via Dart-side CertificatePinningService instead. -->
		<!-- To enable iOS-level pinning: -->
		<!-- 1. Run: ./scripts/generate_cert_pins.sh api.sahool.app -->
		<!-- 2. Copy SPKI-SHA256-BASE64 values from output -->
		<!-- 3. Uncomment NSPinnedDomains and replace placeholder values -->
		<!-- 4. Test on device before deploying to production -->

		<!-- Exception for localhost in development -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>10.0.2.2</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>يحتاج التطبيق للوصول إلى الكاميرا لالتقاط صور المحاصيل والحقول</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>يحتاج التطبيق للوصول إلى مكتبة الصور لاختيار صور المحاصيل</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>يحتاج التطبيق لحفظ الصور في مكتبة الصور</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يحتاج التطبيق لموقعك لتحديد موقع الحقول على الخريطة</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>يحتاج التطبيق لموقعك لتتبع مواقع الحقول وتقديم توصيات محلية</string>
	<!-- Microphone & Speech Recognition — required by speech_to_text package
	     (lib/core/voice/voice_service.dart). Without these keys, iOS silently
	     rejects the permission request and the voice service reports
	     "recognition not available" instead of "permission denied". -->
	<key>NSMicrophoneUsageDescription</key>
	<string>يحتاج التطبيق إلى الميكروفون لتلقي الأوامر الصوتية والاستفسارات الزراعية باللغة العربية</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>يستخدم التطبيق خدمة التعرف على الصوت لتحويل كلامك إلى نص والرد على استفساراتك الزراعية</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sahool</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
