# SAHOOL Atmosphere App Environment Configuration
# تكوين بيئة تطبيق سهول أتموسفير
# Copy this file to .env and configure for your environment

# ─────────────────────────────────────────────────────────────────────────────
# API Configuration - Kong API Gateway
# تكوين API عبر بوابة Kong
# ─────────────────────────────────────────────────────────────────────────────
# Environment: development | staging | production
ENV=development

# Kong API Gateway Configuration
# Development (Android Emulator): http://10.0.2.2:8000 (localhost mapped)
# Development (iOS Simulator): http://localhost:8000
# Development (Physical Device): http://<your-local-ip>:8000
# Staging: https://api-staging.sahool.io
# Production: https://api.sahool.io
API_BASE_URL=http://10.0.2.2:8000
API_VERSION=v1

# ─────────────────────────────────────────────────────────────────────────────
# External API Keys (required for full functionality)
# مفاتيح API الخارجية (مطلوبة للوظائف الكاملة)
# ─────────────────────────────────────────────────────────────────────────────
WEATHER_API_KEY=your_weather_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# أعلام الميزات
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
ENABLE_OFFLINE_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Debug Settings (set to false in production)
# إعدادات التصحيح (اضبط على false في الإنتاج)
# ─────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
