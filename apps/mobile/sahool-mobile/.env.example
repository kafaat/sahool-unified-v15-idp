# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL Mobile (React Native) - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env.development / .env.staging / .env.production as needed.
# Do NOT commit actual secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# Environment
ENV=development

# API
API_BASE_URL=http://localhost:8000/api/v1
WS_GATEWAY_URL=ws://localhost:8081

# Sync
SYNC_INTERVAL_MS=30000
MAX_RETRY_COUNT=5
SYNC_BATCH_SIZE=50
CONFLICT_RESOLUTION=server_wins

# Security
ENABLE_CERTIFICATE_PINNING=false
ENABLE_DEVICE_INTEGRITY=false

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_BACKGROUND_SYNC=true

# Debug
DEBUG_MODE=true
LOG_LEVEL=debug
