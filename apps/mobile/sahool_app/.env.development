# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL Mobile - Development Environment
# بيئة التطوير
# ═══════════════════════════════════════════════════════════════════════════════
# This file is for local development. Secrets should be empty or use test values.
# For physical device testing, update DEV_HOST to your machine's IP address.
# ═══════════════════════════════════════════════════════════════════════════════

# Environment
ENV=development

# ─────────────────────────────────────────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────────────────────────────────────────
# Android Emulator uses 10.0.2.2 to reach host machine
# iOS Simulator uses localhost
# Physical device: use your machine's IP (e.g., 192.168.1.5)
API_BASE_URL=http://10.0.2.2:8000/api/v1
DEV_HOST=10.0.2.2

# WebSocket Gateway
# nosemgrep: detect-insecure-websocket -- development-only config file, production uses .env.production with wss://
WS_GATEWAY_URL=ws://10.0.2.2:8081

# NATS Message Queue
NATS_URL=nats://10.0.2.2:4222

# ─────────────────────────────────────────────────────────────────────────────────
# External API Keys (optional for development)
# ─────────────────────────────────────────────────────────────────────────────────
# Weather - Open-Meteo is used by default (free, no key required)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Maps - OpenStreetMap is used by default (free, no key required)
MAP_PROVIDER=osm
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# Error Reporting (disabled in development)
# ─────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
ENABLE_CRASH_REPORTING=false
ENABLE_ANALYTICS=false

# ─────────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────────
ENABLE_OFFLINE_MODE=true
ENABLE_BACKGROUND_SYNC=true
ENABLE_CAMERA=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_EDGE_AI=false

# ─────────────────────────────────────────────────────────────────────────────────
# Security (relaxed for development)
# ─────────────────────────────────────────────────────────────────────────────────
ENABLE_BIOMETRIC_AUTH=true
ENABLE_CERTIFICATE_PINNING=false
ENABLE_DEVICE_INTEGRITY=false
ENABLE_DATABASE_ENCRYPTION=false
SKIP_DEVICE_CHECKS=true

# ─────────────────────────────────────────────────────────────────────────────────
# Sync Configuration
# ─────────────────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_SECONDS=30
BG_SYNC_INTERVAL_MINUTES=15
MAX_RETRY_COUNT=5
OUTBOX_BATCH_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────────
# Timeouts (longer for debugging)
# ─────────────────────────────────────────────────────────────────────────────────
CONNECT_TIMEOUT_SECONDS=60
RECEIVE_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────────
# App Info
# ─────────────────────────────────────────────────────────────────────────────────
APP_NAME=SAHOOL Dev
APP_VERSION=16.0.0
BUILD_NUMBER=1
DEFAULT_TENANT_ID=sahool-dev

# ─────────────────────────────────────────────────────────────────────────────────
# AI Service
# ─────────────────────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://10.0.2.2:8095

# ─────────────────────────────────────────────────────────────────────────────────
# Debug Settings
# ─────────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=true
LOG_LEVEL=debug
