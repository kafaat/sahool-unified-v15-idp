<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sahool Field App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sahool_field_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Camera Permission - Required for image_picker, camera, mobile_scanner -->
	<key>NSCameraUsageDescription</key>
	<string>SAHOOL needs camera access to capture field photos, scan QR codes, and document crop conditions.</string>

	<!-- Photo Library Permissions - Required for image_picker -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SAHOOL needs photo library access to select existing field images for crop documentation.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SAHOOL needs permission to save captured field photos to your photo library.</string>

	<!-- Location Permissions - Required for geolocator and flutter_map -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SAHOOL needs your location to display your position on field maps and record field boundaries.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SAHOOL needs continuous location access to track field operations and sync data in the background.</string>

	<!-- Biometric Authentication - Required for local_auth (Face ID) -->
	<key>NSFaceIDUsageDescription</key>
	<string>SAHOOL uses Face ID for secure authentication to protect your agricultural data.</string>

	<!-- Microphone & Speech Recognition — required by speech_to_text package.
	     Without these keys, iOS silently rejects the permission request and
	     the voice service reports "recognition not available" instead of
	     "permission denied". -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SAHOOL needs microphone access to receive voice commands and spoken agricultural queries.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SAHOOL uses speech recognition to convert your spoken questions into text so the agricultural advisor can respond.</string>

	<!-- Background Modes - Required for workmanager background sync -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- App Transport Security - Certificate Pinning Configuration -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- Certificate Pinning for Production Domains -->
		<!-- NOTE: NSPinnedDomains disabled until real SPKI hashes are generated. -->
		<!-- Placeholder values (AAAA...) would block ALL connections to pinned domains. -->
		<!-- Certificate pinning is enforced via Dart-side CertificatePinningService instead. -->
		<!-- To enable iOS-level pinning: -->
		<!-- 1. Run: ./scripts/generate_cert_pins.sh api.sahool.app -->
		<!-- 2. Copy SPKI-SHA256-BASE64 values from output -->
		<!-- 3. Uncomment NSPinnedDomains below and replace placeholder values -->
		<!-- 4. Test on device before deploying to production -->
		<!--
		<key>NSPinnedDomains</key>
		<dict>
			<key>api.sahool.app</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
