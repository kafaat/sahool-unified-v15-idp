# AI Chat Assistant Service Environment Variables
# متغيرات بيئة خدمة مساعد الشات الذكي

# Service Configuration
PORT=8230
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=ai-chat-assistant

# NATS Configuration
NATS_URL=nats://nats:4222
NATS_RECONNECT_TIME_WAIT=2
NATS_MAX_RECONNECT_ATTEMPTS=60

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true

# LLM Orchestrator
LLM_ORCHESTRATOR_URL=http://llm-orchestrator-service:8164
LLM_ORCHESTRATOR_TIMEOUT=30

# Caching
CACHE_TTL_SECONDS=604800
CACHE_SIMILARITY_THRESHOLD=0.9
CACHE_ENABLED=true

# AI Behavior
MIN_CONFIDENCE_THRESHOLD=0.6
HIGH_CONFIDENCE_THRESHOLD=0.85
AUTO_SEND_CONFIDENCE_THRESHOLD=0.85

# Rate Limiting
RATE_LIMIT_PER_USER_HOUR=10
RATE_LIMIT_ENABLED=true

# Query Constraints
MAX_QUERY_LENGTH=1000
MIN_QUERY_LENGTH=3

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=8231
