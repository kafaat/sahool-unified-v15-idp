{
  "name": "@sahool/code-review-agent",
  "version": "1.0.0",
  "description": "AI-powered code review agent using Claude Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/production-agent.js",
    "dev": "tsx watch src/production-agent.ts",
    "review": "tsx src/production-agent.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.51",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "code-review",
    "agent",
    "claude",
    "ai",
    "static-analysis"
  ],
  "author": "KAFAAT",
  "license": "UNLICENSED",
  "private": true,
  "overrides": {
    "lodash": ">=4.17.21",
    "picomatch": "^4.0.4"
  }
}
