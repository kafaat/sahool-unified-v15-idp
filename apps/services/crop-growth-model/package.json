    "@nestjs/passport": "^10.0.3",
    "@sahool/nestjs-auth": "16.0.0",
    "@liaoliaots/nestjs-redis": "^9.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
