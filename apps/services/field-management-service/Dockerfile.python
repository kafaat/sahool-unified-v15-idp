# SAHOOL Field Core - Python Profitability Service
# Crop profitability analysis and financial insights
# Port: 3000

FROM python:3.12-slim

WORKDIR /app

# Configure pip for network resilience
RUN mkdir -p /root/.pip && \
    printf '[global]\ntimeout = 300\nretries = 10\nindex-url = https://mirrors.aliyun.com/pypi/simple/\nextra-index-url = https://pypi.tuna.tsinghua.edu.cn/simple/\n                  https://pypi.org/simple/\n[install]\nprefer-binary = true\n' > /root/.pip/pip.conf

# Install dependencies
# NOTE: Build context must be project root:
#   docker build -f apps/services/field-management-service/Dockerfile.python -t sahool-field-profitability:16.0.0 .
COPY constraints.txt .
COPY apps/services/field-management-service/requirements.txt .
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -c constraints.txt -r requirements.txt || \
    pip install --no-cache-dir --timeout=600 --retries=5 \
    --index-url https://pypi.org/simple \
    -c constraints.txt -r requirements.txt || \
    pip install --no-cache-dir --timeout=600 --retries=5 \
    -i https://mirrors.cloud.tencent.com/pypi/simple \
    -c constraints.txt -r requirements.txt

# Copy Python source files
COPY apps/services/field-management-service/src/profitability_analyzer.py ./
COPY apps/services/field-management-service/src/main.py ./
COPY apps/services/field-management-service/src/__init__.py ./

# Create non-root user for security
RUN groupadd -r sahool && \
    useradd -r -g sahool -u 1001 sahool && \
    chown -R sahool:sahool /app

USER sahool

# Environment
ENV PORT=3000
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3000/healthz')" || exit 1

# Run application
CMD ["python", "main.py"]
