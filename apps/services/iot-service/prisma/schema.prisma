// ═══════════════════════════════════════════════════════════════════════════
// SAHOOL IoT Service - Prisma Schema
// Database: PostgreSQL
// Aligned with platform conventions (field-management-service patterns)
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct URL for migrations (bypasses PgBouncer connection pooler)
  directUrl = env("DATABASE_URL_DIRECT")
  // TLS/SSL enforcement for secure connections
  // Requires DATABASE_URL to include sslmode=require parameter
  // Connection pooling parameters are configured in DATABASE_URL
  // Example: postgresql://user:pass@pgbouncer:6432/db?sslmode=require&connection_limit=6&pool_timeout=20&connect_timeout=10
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DeviceType {
  SOIL_MOISTURE_SENSOR
  TEMPERATURE_SENSOR
  HUMIDITY_SENSOR
  WATER_FLOW_METER
  WEATHER_STATION
  VALVE_CONTROLLER
  PUMP_CONTROLLER
  IRRIGATION_CONTROLLER
  CAMERA
  GATEWAY
  CUSTOM
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
  INACTIVE
}

enum SensorType {
  SOIL_MOISTURE
  SOIL_TEMPERATURE
  AIR_TEMPERATURE
  AIR_HUMIDITY
  LIGHT_INTENSITY
  WATER_FLOW
  WATER_PRESSURE
  WATER_LEVEL
  PH_LEVEL
  EC_LEVEL
  BATTERY_LEVEL
  SIGNAL_STRENGTH
  RAINFALL
  WIND_SPEED
  WIND_DIRECTION
  CUSTOM
}

enum ActuatorType {
  VALVE
  PUMP
  MOTOR
  RELAY
  SWITCH
  SERVO
  CUSTOM
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum CommandStatus {
  PENDING
  EXECUTING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Device - الأجهزة
// Physical IoT devices (sensors, actuators, gateways)
// ─────────────────────────────────────────────────────────────────────────────

model Device {
  id       String @id @default(uuid()) @db.Uuid

  // Tenant & Identity
  tenantId String       @map("tenant_id") @db.VarChar(100)
  deviceId String       @map("device_id") @db.VarChar(255) // Unique device identifier from the physical device
  name     String       @db.VarChar(255)
  type     DeviceType
  status   DeviceStatus @default(OFFLINE)

  // Device State
  lastSeen DateTime? @map("last_seen") @db.Timestamptz
  metadata Json?     @db.JsonB // Additional device metadata (manufacturer, model, firmware version, etc.)
  fieldId  String?   @map("field_id") @db.VarChar(100) // Optional reference to field/zone

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  sensors        Sensor[]
  sensorReadings SensorReading[]
  actuators      Actuator[]
  alerts         DeviceAlert[]

  @@unique([tenantId, deviceId])
  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@index([fieldId])
  @@index([lastSeen])
  @@index([tenantId, status])
  @@index([tenantId, fieldId])
  @@map("devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sensor - المستشعرات
// Sensor metadata & last reading cache
// ─────────────────────────────────────────────────────────────────────────────

model Sensor {
  id String @id @default(uuid()) @db.Uuid

  // Tenant & Device
  tenantId   String     @map("tenant_id") @db.VarChar(100)
  deviceId   String     @map("device_id") @db.Uuid
  sensorType SensorType @map("sensor_type")

  // Sensor Configuration
  unit            String @db.VarChar(50) // Unit of measurement (e.g., "%", "°C", "L/min")
  calibrationData Json?  @map("calibration_data") @db.JsonB // Calibration parameters and coefficients

  // Last Reading Cache
  lastReading   Float?    @map("last_reading")
  lastReadingAt DateTime? @map("last_reading_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  device   Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings SensorReading[]

  @@index([tenantId])
  @@index([deviceId])
  @@index([sensorType])
  @@index([deviceId, sensorType])
  @@index([tenantId, deviceId]) // Tenant-scoped device sensor lookup
  @@index([tenantId, sensorType]) // Tenant-scoped sensor type filtering
  @@map("sensors")
}

// ─────────────────────────────────────────────────────────────────────────────
// SensorReading - قراءات المستشعرات
// Historical time-series data
// ─────────────────────────────────────────────────────────────────────────────

model SensorReading {
  id String @id @default(uuid()) @db.Uuid

  // References
  tenantId String @map("tenant_id") @db.VarChar(100)
  sensorId String @map("sensor_id") @db.Uuid
  deviceId String @map("device_id") @db.Uuid

  // Reading Data
  value     Float
  unit      String   @db.VarChar(50)
  timestamp DateTime @default(now()) @db.Timestamptz
  quality   Float?   @default(1.0) // Quality indicator 0-1, null means unknown
  metadata  Json?    @db.JsonB // Additional reading metadata (raw value, calibrated value, etc.)

  // Relations
  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sensorId])
  @@index([deviceId])
  @@index([timestamp])
  @@index([sensorId, timestamp])
  @@index([deviceId, timestamp])
  @@index([deviceId, sensorId, timestamp]) // Optimize historical queries for specific sensor on device
  @@index([tenantId, sensorId, timestamp]) // Tenant-scoped sensor time-series queries
  @@index([tenantId, deviceId, timestamp]) // Tenant-scoped device time-series queries
  @@index([tenantId, timestamp]) // Tenant-scoped time range queries
  @@map("sensor_readings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Actuator - المشغلات
// Controllable devices (pumps, valves, motors)
// ─────────────────────────────────────────────────────────────────────────────

model Actuator {
  id String @id @default(uuid()) @db.Uuid

  // Tenant & Device
  tenantId     String       @map("tenant_id") @db.VarChar(100)
  deviceId     String       @map("device_id") @db.Uuid
  actuatorType ActuatorType @map("actuator_type")

  // Actuator State
  name          String? @db.VarChar(255)
  currentState  Json?   @map("current_state") @db.JsonB // Current state (e.g., {"position": 50, "enabled": true})
  lastCommand   String? @map("last_command") @db.VarChar(255)
  lastCommandAt DateTime? @map("last_command_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commands ActuatorCommand[]

  @@index([tenantId])
  @@index([deviceId])
  @@index([actuatorType])
  @@index([deviceId, actuatorType])
  @@index([tenantId, deviceId]) // Tenant-scoped device actuator lookup
  @@map("actuators")
}

// ─────────────────────────────────────────────────────────────────────────────
// ActuatorCommand - أوامر المشغلات
// Command execution history
// ─────────────────────────────────────────────────────────────────────────────

model ActuatorCommand {
  id String @id @default(uuid()) @db.Uuid

  // References
  tenantId   String @map("tenant_id") @db.VarChar(100)
  actuatorId String @map("actuator_id") @db.Uuid

  // Command Details
  command      String        @db.VarChar(255) // Command name (e.g., "open", "close", "set_position")
  parameters   Json?         @db.JsonB // Command parameters
  status       CommandStatus @default(PENDING)
  errorMessage String?       @map("error_message") @db.Text

  // Execution Timestamps
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  executedAt  DateTime? @map("executed_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  actuator Actuator @relation(fields: [actuatorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([actuatorId])
  @@index([status])
  @@index([requestedAt])
  @@index([actuatorId, status])
  @@index([actuatorId, requestedAt])
  @@index([tenantId, status, requestedAt]) // Tenant-scoped command status queries
  @@map("actuator_commands")
}

// ─────────────────────────────────────────────────────────────────────────────
// DeviceAlert - تنبيهات الأجهزة
// Alert/warning events
// ─────────────────────────────────────────────────────────────────────────────

model DeviceAlert {
  id String @id @default(uuid()) @db.Uuid

  // References
  deviceId String @map("device_id") @db.Uuid
  tenantId String @map("tenant_id") @db.VarChar(100)

  // Alert Details
  alertType    String        @map("alert_type") @db.VarChar(100) // Type of alert (e.g., "offline", "battery_low", "sensor_error")
  severity     AlertSeverity
  message      String        @db.Text
  acknowledged Boolean       @default(false)

  // Resolution
  acknowledgedBy String?   @map("acknowledged_by") @db.VarChar(255)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  metadata       Json?     @db.JsonB // Additional alert data

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([tenantId])
  @@index([severity])
  @@index([acknowledged])
  @@index([createdAt])
  @@index([tenantId, acknowledged])
  @@index([tenantId, severity])
  @@index([deviceId, acknowledged])
  @@map("device_alerts")
}
