generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth (NextAuth v5 Prisma Adapter) ──────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // bcrypt hash; null for OAuth users
  role      String   @default("user")    // "user" | "admin"
  status    String   @default("active")  // "active" | "suspended"
  pushToken String?  // Expo push token for mobile notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  fields       Field[]
  sentinelReqs SentinelRequest[]
  weatherReqs  WeatherRequest[]
  apiUsage     ApiUsageLog[]
  auditActions AdminAuditLog[]   @relation("AdminActions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ─────────────────────────────────────────────────────────────────

model Field {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  // Stored as JSON string: [minLng, minLat, maxLng, maxLat] (WGS84)
  // Directly compatible with sentinelhub BBox([W,S,E,N], CRS.WGS84)
  bbox        String
  centerLng   Float?
  centerLat   Float?
  areaSqKm    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentinelReqs SentinelRequest[]
  weatherReqs  WeatherRequest[]
}

// ── Usage tracking ─────────────────────────────────────────────────────────

model SentinelRequest {
  id         String   @id @default(cuid())
  userId     String
  fieldId    String?
  index      String   // NDVI | EVI | NDWI | TRUE_COLOR | FALSE_COLOR
  bbox       String
  dateFrom   String
  dateTo     String
  statusCode Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
}

model WeatherRequest {
  id         String   @id @default(cuid())
  userId     String
  fieldId    String?
  endpoint   String   // current | forecast | history | agro
  lat        Float
  lng        Float
  statusCode Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
}

model ApiUsageLog {
  id            String   @id @default(cuid())
  userId        String
  date          String   // YYYY-MM-DD
  sentinelCalls Int      @default(0)
  weatherCalls  Int      @default(0)
  sentinelLimit Int      @default(50)
  weatherLimit  Int      @default(50)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ── Admin ──────────────────────────────────────────────────────────────────

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // user.suspend | user.activate | field.revoke | …
  targetId  String
  meta      String?  // JSON blob
  createdAt DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
}
