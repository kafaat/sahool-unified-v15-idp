# SAHOOL Web Dashboard - Environment Variables
# Copy this file to .env.local for local development

# API URL - Backend services gateway
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL - Real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Copilot API URL - AI assistant
NEXT_PUBLIC_COPILOT_API_URL=http://localhost:8088

# Sentry DSN - Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# App version (auto-set in CI)
NEXT_PUBLIC_APP_VERSION=16.0.0

# Bundle analyzer (set to "true" to enable)
ANALYZE=

# Docker build mode (set to "true" for standalone output)
DOCKER_BUILD=
