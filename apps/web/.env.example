# SAHOOL Web Dashboard - Environment Variables
# Copy this file to .env.local for local development

# API URL - Backend services gateway (build-time, baked into client JS)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Gateway URL - Server-side runtime override for Next.js rewrites
# In production (Docker/K8s), set this to the internal Kong gateway URL:
#   Docker Compose: http://kong-gateway:8000
#   Kubernetes:     http://kong.kong.svc.cluster.local:8000
# If unset, falls back to NEXT_PUBLIC_API_URL → http://localhost:8000
API_GATEWAY_URL=

# WebSocket URL - Real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Copilot API URL - AI assistant
NEXT_PUBLIC_COPILOT_API_URL=http://localhost:8088

# Sentry DSN - Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# App version (auto-set in CI)
NEXT_PUBLIC_APP_VERSION=16.0.0

# JWT Configuration (server-side, for middleware token validation)
JWT_SECRET_KEY=
JWT_ISSUER=sahool
JWT_AUDIENCE=sahool-web

# Redis URL (server-side, for rate limiting - optional, falls back to in-memory)
REDIS_URL=

# CSP Configuration (optional)
CSP_REPORT_ONLY=false

# Development ports (optional, used in CSP allowed origins)
DEV_API_PORT=8000
DEV_WS_PORT=8081
DEV_WEB_PORT=3000
DEV_ADMIN_PORT=3002

# Google Maps API Key (used for field boundary drawing)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBTbdDsOaqRkDLyKjqFFjTQkjNPvBKRqns

# Bundle analyzer (set to "true" to enable)
ANALYZE=

# Docker build mode (set to "true" for standalone output)
DOCKER_BUILD=
