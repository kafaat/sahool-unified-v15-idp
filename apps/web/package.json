{
  "name": "sahool-web",
  "version": "16.0.0",
  "description": "Sahool Agricultural Platform - Main Web Application",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "analyze": "ANALYZE=true next build",
    "analyze:server": "ANALYZE=true BUNDLE_ANALYZE=server next build",
    "analyze:browser": "ANALYZE=true BUNDLE_ANALYZE=browser next build",
    "docs": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/instrumentation": "^0.57.2",
    "@opentelemetry/redis-common": "^0.36.2",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@opentelemetry/sql-common": "^0.40.1",
    "@sahool/api-client": "^16.0.0",
    "@sahool/i18n": "^16.0.0",
    "@sahool/shared-types": "^16.0.0",
    "@tanstack/query-core": "^5.90.20",
    "@tanstack/react-query": "5.90.21",
    "axios": "1.13.6",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "forwarded-parse": "^2.1.2",
    "hoist-non-react-statics": "^3.3.2",
    "ioredis": "^5.4.1",
    "jose": "5.9.6",
    "js-cookie": "3.0.5",
    "leaflet": "1.9.4",
    "lucide-react": "0.575.0",
    "maplibre-gl": "4.7.1",
    "next": "15.5.12",
    "next-intl": "3.26.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-focus-lock": "^2.13.7",
    "react-leaflet": "4.2.1",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.3",
    "@next/bundle-analyzer": "^15.0.0",
    "@next/eslint-plugin-next": "^15.5.12",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/ioredis": "^5.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.19.37",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.12",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fraction.js": "^5.3.4",
    "globals": "^17.4.0",
    "jsdom": "^27.3.0",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "^6.4.1",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "@sentry/nextjs": "^9.5.0"
  }
}
