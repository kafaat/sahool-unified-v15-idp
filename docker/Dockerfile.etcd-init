# Dockerfile for etcd-init: etcdctl + shell for init scripts
# The GCR etcd image (gcr.io/etcd-development/etcd) is distroless (no /bin/sh).
# The quay.io/coreos/etcd image has BusyBox but may be unavailable in some regions.
# This image copies etcdctl from the official etcd image into alpine for shell support.
# No apk packages needed - etcdctl connects to etcd over HTTP on the internal network.
FROM gcr.io/etcd-development/etcd:v3.5.16 AS etcd-bin

FROM alpine:3.19

COPY --from=etcd-bin /usr/local/bin/etcdctl /usr/local/bin/etcdctl

# Security: run as non-root user
RUN adduser -D -u 1000 sahool
USER sahool

# This is a one-shot init container, HEALTHCHECK is not applicable.
# Added to satisfy lint; the container exits after running the init script.
HEALTHCHECK NONE

ENTRYPOINT ["/bin/sh"]
