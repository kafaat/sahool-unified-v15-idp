# SAHOOL Base Docker Image for Node.js Services
# ==============================================
# Version: 16.0.0
# Updated: December 2025

ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-slim AS base

# Build arguments
ARG SERVICE_NAME=unknown
ARG SERVICE_VERSION=0.0.0

# Labels
LABEL org.opencontainers.image.title="SAHOOL ${SERVICE_NAME}"
LABEL org.opencontainers.image.version="${SERVICE_VERSION}"
LABEL org.opencontainers.image.vendor="KAFAAT"

# Environment
ENV NODE_ENV=production \
    NPM_CONFIG_LOGLEVEL=warn

WORKDIR /app

# Create non-root user
RUN groupadd --system --gid 1000 sahool && \
    useradd --system --uid 1000 --gid sahool --shell /bin/bash --create-home sahool

# Install system dependencies and upgrade packages to patch CVEs (tini for proper PID 1 signal handling)
COPY docker/apt-update.sh /usr/local/bin/
RUN apt-update.sh && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Configure npm registry mirror for network resilience
RUN npm config set registry https://registry.npmmirror.com

# ─────────────────────────────────────────────────────────────────────────────
# Dependencies Stage
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS dependencies

# Copy package files
COPY package*.json ./

# Install production dependencies only
# Using --omit=dev instead of deprecated --only=production
RUN npm ci --omit=dev || \
    (npm config set registry https://registry.npmjs.org && npm ci --omit=dev)

# ─────────────────────────────────────────────────────────────────────────────
# Build Stage (for TypeScript)
# ─────────────────────────────────────────────────────────────────────────────
FROM dependencies AS builder

# Install all dependencies (including dev)
RUN npm ci || \
    (npm config set registry https://registry.npmjs.org && npm ci)

# Copy source
COPY . .

# Build TypeScript
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Production Stage
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS production

# Copy node_modules from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy package files for npm audit
COPY --from=dependencies /app/package*.json ./

# Apply security patches to production dependencies (fix known CVEs in transitive deps)
RUN npm audit fix --omit=dev --ignore-scripts 2>/dev/null || true

# Copy built files from builder stage
COPY --from=builder /app/dist ./dist

# Set ownership
RUN chown -R sahool:sahool /app

# Switch to non-root user
USER sahool

# Default port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/healthz || exit 1

# Use tini as init system for proper signal handling and zombie reaping
ENTRYPOINT ["/usr/bin/tini", "--"]

# Default command
CMD ["node", "dist/main.js"]
