# ═══════════════════════════════════════════════════════════════════════════════
# SAHOOL vLLM Configuration
# إعدادات خادم vLLM
# ═══════════════════════════════════════════════════════════════════════════════

# Model - النموذج
VLLM_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct

# Server - الخادم
VLLM_PORT=8000
VLLM_HOST=0.0.0.0
VLLM_EXTERNAL_PORT=127.0.0.1:8000

# Model Parameters - إعدادات النموذج
VLLM_MAX_MODEL_LEN=16384

# GPU Configuration - إعدادات المعالج الرسومي
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0
VLLM_GPU_COUNT=1
VLLM_MEMORY_LIMIT=32G

# HuggingFace Token (for gated models) - رمز HuggingFace
HF_TOKEN=
