    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Elapsed seconds since the worker last completed. Expected: <25h. Beyond 25h triggers AuditRetentionJobStalled.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 86400 },
              { "color": "red", "value": 90000 }
            ]
          },
          "unit": "s"
        }
