{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "changes(audit_chain_valid[$__interval]) > 0",
        "iconColor": "red",
        "name": "Chain state changes",
        "titleFormat": "Chain state changed on {{tenant_id}}"
      }
    ]
  },
  "description": "SAHOOL Audit Service — tamper-evident hash chain integrity + write-pipeline health. Feeds the AuditHashChainBroken and AuditServiceNotReceivingWrites alerts defined in infrastructure/monitoring/prometheus/rules/audit-alerts.yml. Backed by audit_chain_valid{tenant_id} gauge (refreshed by _chain_validation_loop in apps/services/audit-service/src/main.py), audit_writes_total{tenant_id,category} counter, and audit_store_backend{kind} gauge. Also surfaces retention-pipeline observability via audit_retention_* metrics (pushgateway) and audit_chain_retention_gaps_crossed{tenant_id} so operators can distinguish a legitimate chain re-anchor from tampering. | لوحة معلومات سلامة سلسلة التجزئة لخدمة التدقيق.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Audit Service Runbook",
      "url": "https://sahool.io/runbooks/audit-chain-broken",
      "targetBlank": true,
      "type": "link"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Hash Chain Integrity | سلامة سلسلة التجزئة",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-tenant hash chain validity (0 = BROKEN, 1 = VALID). Any cell != 1 is a compliance-grade incident. Background _chain_validation_loop in audit-service refreshes this every AUDIT_CHAIN_VALIDATION_INTERVAL_SECONDS (default 300s) for tenants with activity in the lookback window.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "BROKEN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 1, "text": "VALID" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "audit_chain_valid",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "title": "Chain Validity Per Tenant | صلاحية السلسلة لكل مستأجر",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Count of tenants whose chain is currently BROKEN. Should always be 0. Non-zero triggers the AuditHashChainBroken critical alert after 2 minutes. `== bool 0` returns 1-per-matching-series so `sum(...)` is the tenant count; without the `bool` modifier PromQL would keep the original 0 sample value and always sum to zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(audit_chain_valid == bool 0)",
          "legendFormat": "Broken chains",
          "refId": "A"
        }
      ],
      "title": "Broken Chains (must be 0) | سلاسل مكسورة",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "audit_store_backend current mode. in_memory in prod/staging is a critical misconfiguration — writes are lost on restart. Colour is driven by which series is firing: the in_memory gauge going to 1 turns the panel red, postgres staying at 1 keeps it green.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "displayName", "value": "postgres (OK)" },
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "displayName", "value": "in_memory (LOSS RISK)" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "audit_store_backend{kind=\"postgres\"}",
          "legendFormat": "postgres",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "audit_store_backend{kind=\"in_memory\"}",
          "legendFormat": "in_memory",
          "refId": "B"
        }
      ],
      "title": "Active Backend | الـ backend النشط",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "panels": [],
      "title": "Write Pipeline Health | صحة خط الكتابة",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Audit write rate per tenant over time. Sudden drops trigger AuditServiceWriteRateBelowBaseline (info after 15m) or AuditServiceNotReceivingWrites (warning after 10m if rate hits 0).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "writes/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "wps"
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tenant_id) (rate(audit_writes_total[5m]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "title": "Write Rate Per Tenant (5m rate) | معدل الكتابة لكل مستأجر",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Breakdown of audit writes by category: authentication (login/logout/password), field_ops (boundary/crop_season/operation), billing (invoice/payment/subscription), security (alert.triggered), system (fallback). Shifts in the mix suggest either a producer bug or a behavioural change.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (category) (increase(audit_writes_total[5m]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "title": "Writes By Category (5m buckets) | الكتابات حسب التصنيف",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Writes that raised an exception in AuditStore.write(). Should be near zero. Persistent failures usually mean DB connectivity, RLS session-variable misconfig, or a malformed event payload from a producer.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "unit": "wps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tenant_id) (rate(audit_write_failures_total[5m]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "title": "Write Failures Rate | معدل فشل الكتابات",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 9,
      "panels": [],
      "title": "Retention Activity | نشاط الاحتفاظ",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total successful retention runs in the last 24 hours across all tenants. Zero after >25h triggers AuditRetentionJobStalled.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(audit_retention_runs_total{status=\"success\"}[24h]))",
          "legendFormat": "Successful runs (24h)",
          "refId": "A"
