    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Composite health score (0–100). ≥80 Healthy | 50–79 Warning | 20–49 Critical | <20 Emergency",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "from": 80, "result": { "color": "green", "text": "HEALTHY" }, "to": 100 }, "type": "range" },
            { "options": { "from": 50, "result": { "color": "yellow", "text": "WARNING" }, "to": 79.99 }, "type": "range" },
            { "options": { "from": 20, "result": { "color": "orange", "text": "CRITICAL" }, "to": 49.99 }, "type": "range" },
            { "options": { "from": 0, "result": { "color": "red", "text": "EMERGENCY" }, "to": 19.99 }, "type": "range" }
          ],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
