        "pluginVersion": "10.2.0",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "editorMode": "code",
            "expr": "rate(pg_stat_database_xact_commit{datname=~\"$database\"}[5m])",
            "legendFormat": "Commits",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
