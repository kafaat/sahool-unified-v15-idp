{
  "dashboard": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\", category=\"database\"}",
          "iconColor": "red",
          "name": "Database Alerts",
          "tagKeys": "alertname,severity",
          "titleFormat": "{{ alertname }}"
        }
      ]
    },
    "description": "SAHOOL PostgreSQL Database Performance Monitoring | مراقبة أداء قاعدة بيانات PostgreSQL",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
      {
        "asDropdown": true,
        "icon": "external link",
        "includeVars": true,
        "keepTime": true,
        "tags": ["sahool"],
        "targetBlank": true,
        "title": "SAHOOL Dashboards",
        "type": "dashboards"
      }
    ],
    "liveNow": false,
    "panels": [
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "id": 100,
        "panels": [],
        "title": "Overview | نظرة عامة",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "description": "Database connection pool utilization | استخدام مجموعة الاتصالات",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
        "id": 1,
        "options": {
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "pluginVersion": "10.2.0",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "editorMode": "code",
            "expr": "(pg_stat_database_numbackends{datname=~\"$database\"} / on() pg_settings_max_connections) * 100",
            "legendFormat": "Connection Pool Usage",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Connection Pool | مجموعة الاتصالات",
        "type": "gauge"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "description": "Buffer cache hit ratio (target >95%) | نسبة إصابة الذاكرة المؤقتة",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "max": 1,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.85 },
                { "color": "green", "value": 0.95 }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
        "id": 2,
        "options": {
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "pluginVersion": "10.2.0",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "editorMode": "code",
            "expr": "pg_stat_database_blks_hit{datname=~\"$database\"} / (pg_stat_database_blks_hit{datname=~\"$database\"} + pg_stat_database_blks_read{datname=~\"$database\"} + 1)",
            "legendFormat": "Cache Hit Ratio",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Cache Hit Ratio | نسبة الإصابة",
        "type": "gauge"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "description": "Transactions per second | المعاملات في الثانية",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            },
            "unit": "ops"
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
        "id": 14,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "auto"
        },
        "pluginVersion": "10.2.0",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "editorMode": "code",
            "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"$database\"}[5m]) + rate(pg_stat_database_xact_rollback{datname=~\"$database\"}[5m]))",
            "legendFormat": "TPS",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "TPS | معاملات/ثانية",
        "type": "stat"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "description": "Index vs sequential scan ratio | نسبة المسح الفهرسي مقابل التسلسلي",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [],
            "max": 1,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.8 },
                { "color": "green", "value": 0.95 }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
        "id": 15,
        "options": {
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "pluginVersion": "10.2.0",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "editorMode": "code",
            "expr": "sum(pg_stat_user_tables_idx_scan) / (sum(pg_stat_user_tables_idx_scan) + sum(pg_stat_user_tables_seq_scan) + 1)",
            "legendFormat": "Index Scan Ratio",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Index Scan Ratio | نسبة الفهرسة",
        "type": "gauge"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
