          "expr": "clamp_max(clamp_min(((0.001 - (sum(increase(http_requests_total{status=~\"5..\", service=~\"$service\"}[$__range])) / sum(increase(http_requests_total{service=~\"$service\"}[$__range])))) / 0.001) * 100, -100), 100)",
