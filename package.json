{
  "name": "sahool-unified",
  "version": "16.0.0",
  "description": "SAHOOL - Smart Agricultural Platform for Yemen & Middle East",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/admin",
    "apps/services/field-management-service",
    "apps/services/partner-auth-service",
    "apps/services/user-service",
    "apps/services/chat-service",
    "apps/services/code-review-agent",
    "apps/services/crop-growth-model",
    "apps/services/disaster-assessment",
    "apps/services/iot-service",
    "apps/services/lai-estimation",
    "apps/services/marketplace-service",
    "apps/services/research-core",
    "apps/services/weather-service",
    "apps/services/yield-prediction",
    "apps/services/yield-prediction-service"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node scripts/prisma-generate.js",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:packages": "npm run build --workspace=packages/shared-types && npm run build --workspace=packages/shared-utils && npm run build --workspace=packages/i18n && npm run build --workspace=packages/shared-ui && npm run build --workspace=packages/api-client && npm run build --workspace=packages/shared-hooks",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:all": "npm run build:packages && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspace=apps/admin",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules **/node_modules **/dist",
    "docs": "./scripts/generate-docs.sh",
    "docs:web": "npm run docs --workspace=apps/web",
    "docs:admin": "npm run docs --workspace=apps/admin",
    "contracts:sync-python": "tsx scripts/sync-contracts-to-python.ts",
    "contracts:check-python-drift": "tsx scripts/check-contracts-drift.ts",
    "diagnose": "node scripts/diagnose.js",
    "diagnose:py": "ruff check apps/ shared/ && pyright shared/ai/",
    "diagnose:js": "npx oxlint . && npx knip",
    "diagnose:security": "npm audit && npx snyk test",
    "diagnose:all": "npm run diagnose",
    "diagnose:frontend": "node scripts/diagnose-frontend.js",
    "diagnose:web": "node scripts/diagnose-frontend.js --web",
    "diagnose:mobile": "node scripts/diagnose-frontend.js --mobile",
    "fix": "ruff check --fix apps/ shared/ && ruff format apps/ shared/ && npm run lint:fix",
    "fix:py": "ruff check --fix --unsafe-fixes apps/ shared/ && ruff format apps/ shared/",
    "fix:frontend": "node scripts/diagnose-frontend.js --fix",
    "fix:web": "node scripts/diagnose-frontend.js --web --fix",
    "fix:mobile": "node scripts/diagnose-frontend.js --mobile --fix",
    "dead-code": "npx knip",
    "format": "prettier --write \"apps/{web,admin}/src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"apps/{web,admin}/src/**/*.{ts,tsx,js,jsx}\"",
    "prepare": "node -e \"try{require('child_process').execSync('husky')}catch(e){}\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "depcheck": "^1.4.7",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^27.3.0",
    "knip": "^5.86.0",
    "madge": "^8.0.0",
    "oxlint": "^0.18.1",
    "typedoc": "^0.28.17",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "glob": "^10.5.0",
    "qs": "^6.14.1",
    "js-yaml": "^4.1.1",
    "tmp": "^0.2.4",
    "axios": ">=1.15.0",
    "webpack": ">=5.104.1",
    "lodash": ">=4.18.1",
    "picomatch": ">=4.0.4",
    "rollup": ">=4.58.1",
    "serialize-javascript": ">=7.0.3",
    "minimatch": ">=10.2.3",
    "multer": "2.1.1",
    "nodemailer": "^8.0.4",
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    },
    "ajv-formats": {
      "ajv": "8.18.0"
    },
    "file-type": "21.3.3",
    "prisma": "~5.22.0",
    "@prisma/client": "~5.22.0",
    "handlebars": ">=4.7.9",
    "path-to-regexp": ">=0.1.13",
    "socket.io-parser": ">=4.2.6",
    "smol-toml": ">=1.6.1",
    "yaml": ">=2.8.3",
    "next": ">=15.5.14"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@prisma/client": "~5.22.0",
    "eslint": "^9.39.2",
    "helmet": "^8.1.0",
    "next-intl": "3.26.5",
    "prisma": "~5.22.0",
    "react": "^19.2.4"
  }
}
