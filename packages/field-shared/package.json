{
  "name": "@sahool/field-shared",
  "version": "16.0.0",
  "description": "Shared field management functionality for SAHOOL services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "cors": "^2.8.6",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.37",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^11.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
