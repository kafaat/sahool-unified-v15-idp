{
  "name": "@sahool/i18n",
  "version": "16.0.0",
  "description": "Internationalization package for SAHOOL platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "require": "./dist/config.js",
      "default": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next-intl": "^3.26.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
