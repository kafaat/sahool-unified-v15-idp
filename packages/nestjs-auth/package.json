{
  "name": "@sahool/nestjs-auth",
  "version": "16.0.0",
  "description": "Shared authentication module for SAHOOL NestJS services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nestjs",
    "authentication",
    "jwt",
    "sahool"
  ],
  "author": "SAHOOL Platform",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "ioredis": "^5.0.0",
    "@liaoliaots/nestjs-redis": "^9.0.0",
    "redis": "^4.6.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/jwt": {
      "optional": true
    },
    "@nestjs/passport": {
      "optional": true
    },
    "passport": {
      "optional": true
    },
    "passport-jwt": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@liaoliaots/nestjs-redis": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/passport-jwt": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "typescript": "5.9.3",
    "ioredis": "^5.0.0",
    "@liaoliaots/nestjs-redis": "^9.0.0",
    "redis": "^4.6.0"
  }
}
