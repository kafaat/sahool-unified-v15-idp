{
  "name": "@sahool/shared-crypto",
  "version": "16.0.0",
  "description": "SAHOOL Shared Cryptography Library - مكتبة التشفير المشتركة",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crypto",
    "encryption",
    "AES-256-GCM",
    "field-level-encryption",
    "pii",
    "data-protection"
  ],
  "author": "SAHOOL Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.37",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@prisma/client": "^5.22.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  }
}
