{
  "name": "@sahool/shared-db",
  "version": "16.0.0",
  "description": "Shared database utilities including soft delete pattern for Prisma and SQLAlchemy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sahool",
    "database",
    "soft-delete",
    "prisma",
    "sqlalchemy"
  ],
  "author": "SAHOOL Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0"
  }
}
