{
  "name": "@sahool/shared-events",
  "version": "16.0.0",
  "description": "Shared NATS event bus for SAHOOL microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublish": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nats",
    "events",
    "microservices",
    "sahool"
  ],
  "author": "SAHOOL Platform",
  "license": "MIT",
  "dependencies": {
    "nats": "^2.28.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "^5.9.3"
  }
}
