{
  "name": "@sahool/shared-types",
  "version": "1.1.0",
  "description": "Shared TypeScript types for SAHOOL platform - agricultural intelligence type definitions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common.js",
      "require": "./dist/common.js",
      "types": "./dist/common.d.ts"
    },
    "./geo": {
      "import": "./dist/geo.js",
      "require": "./dist/geo.js",
      "types": "./dist/geo.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "require": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "require": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./field": {
      "import": "./dist/field.js",
      "require": "./dist/field.js",
      "types": "./dist/field.d.ts"
    },
    "./farm": {
      "import": "./dist/farm.js",
      "require": "./dist/farm.js",
      "types": "./dist/farm.d.ts"
    },
    "./task": {
      "import": "./dist/task.js",
      "require": "./dist/task.js",
      "types": "./dist/task.d.ts"
    },
    "./alert": {
      "import": "./dist/alert.js",
      "require": "./dist/alert.js",
      "types": "./dist/alert.d.ts"
    },
    "./weather": {
      "import": "./dist/weather.js",
      "require": "./dist/weather.js",
      "types": "./dist/weather.d.ts"
    },
    "./sensor": {
      "import": "./dist/sensor.js",
      "require": "./dist/sensor.js",
      "types": "./dist/sensor.d.ts"
    },
    "./websocket": {
      "import": "./dist/websocket.js",
      "require": "./dist/websocket.js",
      "types": "./dist/websocket.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "require": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./monitoring": {
      "import": "./dist/monitoring.js",
      "require": "./dist/monitoring.js",
      "types": "./dist/monitoring.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "sahool",
    "types",
    "typescript",
    "agriculture",
    "farming",
    "geojson",
    "iot",
    "sensors"
  ],
  "author": "SAHOOL / KAFAAT",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kafaat/sahool-unified-v15-idp.git",
    "directory": "packages/shared-types"
  }
}
