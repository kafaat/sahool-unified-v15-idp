{
  "name": "@sahool/shared-types",
  "version": "16.0.0",
  "description": "Shared TypeScript types for SAHOOL platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "require": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "require": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "require": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./websocket": {
      "import": "./dist/websocket.js",
      "require": "./dist/websocket.js",
      "types": "./dist/websocket.d.ts"
    },
    "./monitoring": {
      "import": "./dist/monitoring.js",
      "require": "./dist/monitoring.js",
      "types": "./dist/monitoring.d.ts"
    },
    "./field": {
      "import": "./dist/field.js",
      "require": "./dist/field.js",
      "types": "./dist/field.d.ts"
    },
    "./vision": {
      "import": "./dist/vision.js",
      "require": "./dist/vision.js",
      "types": "./dist/vision.d.ts"
    },
    "./terrain": {
      "import": "./dist/terrain.js",
      "require": "./dist/terrain.js",
      "types": "./dist/terrain.d.ts"
    },
    "./edge": {
      "import": "./dist/edge.js",
      "require": "./dist/edge.js",
      "types": "./dist/edge.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "sahool",
    "types",
    "typescript"
  ],
  "author": "SAHOOL",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "express": "^4.21.0",
    "typescript": "5.9.3",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
