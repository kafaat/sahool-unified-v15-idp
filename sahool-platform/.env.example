# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=sahool
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=sahool_auth
POSTGRES_PORT=5432

# ── FastAPI Auth Service ───────────────────────────────────────────────────────
AUTH_HOST=0.0.0.0
AUTH_PORT=8000
# Min 32 characters — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sahool-platform
JWT_AUDIENCE=sahool-api
BCRYPT_COST=12
WEB_PORT=3001
CORS_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://sahool:your_secure_postgres_password@db:5432/sahool_auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourAdminPassword123!
ADMIN_NAME=Admin

# ── Next.js Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://auth:8000
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars

# ── pgAdmin 4 ─────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050
